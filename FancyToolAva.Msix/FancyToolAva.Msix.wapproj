<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '15.0'">
    <VisualStudioVersion>15.0</VisualStudioVersion>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x86">
      <Configuration>Debug</Configuration>
      <Platform>x86</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x86">
      <Configuration>Release</Configuration>
      <Platform>x86</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM">
      <Configuration>Debug</Configuration>
      <Platform>ARM</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM">
      <Configuration>Release</Configuration>
      <Platform>ARM</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|AnyCPU">
      <Configuration>Debug</Configuration>
      <Platform>AnyCPU</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|AnyCPU">
      <Configuration>Release</Configuration>
      <Platform>AnyCPU</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup>
    <WapProjPath Condition="'$(WapProjPath)'==''">$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</WapProjPath>
  </PropertyGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.props" />
  <PropertyGroup>
    <ProjectGuid>{a090bf52-7c87-42f0-82a5-a4fd557df3ce}</ProjectGuid>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <!-- Unsigned packages must not request cleanup of a certificate that was never created. -->
    <GenerateTemporaryStoreCertificate>$(AppxPackageSigningEnabled)</GenerateTemporaryStoreCertificate>
    <NoWarn>$(NoWarn);NU1702;NU1701</NoWarn>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>true</GenerateTestArtifacts>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <EntryPointProjectUniqueName>..\FancyTool\FancyToolAva.csproj</EntryPointProjectUniqueName>
    <!-- VS builds the solution's ordinary app evaluation, not this isolated
         reference. Publish the isolated variant before collecting its outputs. -->
    <WapAlwaysBuildDependentProjects>true</WapAlwaysBuildDependentProjects>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x86'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|ARM'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AppxBundle>Always</AppxBundle>
  </PropertyGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Images\*.png" />
    <None Include="Package.StoreAssociation.xml" />
  </ItemGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.targets" />
  <!-- CLI 负载重定位到包根 cli\。CreateWapProjPackageFiles 给入口工程全部输出统一加
       FancyToolAva\ 前缀（包内 TargetPath 与 layout CopyToTargetPath 都是
       FancyToolAva\cli\...），而清单字面 Executable 不会被打包任务改写，且商店
       Upload 变体还会对非入口应用剥掉 FancyToolAva\ 前缀，三份生成的 AppxManifest
       会互相矛盾。在 _ConvertItems 产出被 _CopyPackageFiles / AppxPackagePayload /
       清单生成消费之前，把 cli\ 项改写为包根路径，与 Package.appxmanifest 的
       Executable="cli\fancy-tool.exe" 字面值保持一致。_FileToCopy / _UploadFileToCopy
       在 _ConvertItems 内部已经生成，必须一并改写。 -->
  <Target Name="RebaseCliPayloadToPackageRoot" AfterTargets="_ConvertItems">
    <ItemGroup>
      <_RebasedCliFiles Include="@(WapProjPackageFile)"
                        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(WapProjPackageFile.TargetPath)', '^FancyToolAva\\cli\\'))" />
    </ItemGroup>
    <ItemGroup Condition="'@(_RebasedCliFiles)' != ''">
      <WapProjPackageFile Remove="@(_RebasedCliFiles)" />
      <UploadWapProjPackageFile Remove="@(_RebasedCliFiles)" />
      <_FileToCopy Remove="@(_RebasedCliFiles)" />
      <_UploadFileToCopy Remove="@(_RebasedCliFiles)" />
      <WapProjPackageFile Include="@(_RebasedCliFiles)"
                          TargetPath="$([System.String]::Copy('%(_RebasedCliFiles.TargetPath)').Replace('FancyToolAva\cli\', 'cli\'))"
                          CopyToTargetPath="$([System.String]::Copy('%(_RebasedCliFiles.CopyToTargetPath)').Replace('\FancyToolAva\cli\', '\cli\'))" />
      <UploadWapProjPackageFile Include="@(_RebasedCliFiles)"
                          TargetPath="$([System.String]::Copy('%(_RebasedCliFiles.TargetPath)').Replace('FancyToolAva\cli\', 'cli\'))"
                          CopyToTargetPath="$([System.String]::Copy('%(_RebasedCliFiles.CopyToTargetPath)').Replace('\FancyToolAva\cli\', '\cli\'))" />
      <_FileToCopy Include="@(_RebasedCliFiles)"
                          TargetPath="$([System.String]::Copy('%(_RebasedCliFiles.TargetPath)').Replace('FancyToolAva\cli\', 'cli\'))"
                          CopyToTargetPath="$([System.String]::Copy('%(_RebasedCliFiles.CopyToTargetPath)').Replace('\FancyToolAva\cli\', '\cli\'))" />
      <_UploadFileToCopy Include="@(_RebasedCliFiles)"
                          TargetPath="$([System.String]::Copy('%(_RebasedCliFiles.TargetPath)').Replace('FancyToolAva\cli\', 'cli\'))"
                          CopyToTargetPath="$([System.String]::Copy('%(_RebasedCliFiles.CopyToTargetPath)').Replace('\FancyToolAva\cli\', '\cli\'))" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FancyTool\FancyToolAva.csproj">
      <!-- The IDE built ordinary dependency outputs. This isolated evaluation
           must build its own complete dependency graph, including references. -->
      <AdditionalProperties>FancyToolMsixBuild=true;BuildingInsideVisualStudio=false;BuildProjectReferences=true</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
  <!-- Restore before DesktopBridge queries deployable content from the isolated app.
       Use a separate evaluation so the publish build loads the new NuGet imports. -->
  <Target Name="RestoreMsixProjectReferences" BeforeTargets="SetProjectReferenceProperties" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="@(ProjectReference)" Targets="Restore" Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=win-x64;SelfContained=true;MSBuildIsRestoring=true" />
  </Target>
</Project>