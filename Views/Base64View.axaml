<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LittleFancyToolAva.ViewModels"
             xmlns:controls="using:LittleFancyToolAva.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="LittleFancyToolAva.Views.Base64View"
             x:DataType="vm:Base64ViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="{StaticResource PageMargin}">
        <controls:ToolPageHeader Grid.Row="0" Title="Base64 编码" Subtitle="文本 Base64 编码与解码" />
        <Grid Grid.Row="1" ColumnDefinitions="*,16,*" Margin="0,16,0,0">
            <Border Grid.Column="0" Classes="ToolCard" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="16,12,16,8">
                        <TextBlock Classes="SectionHeader" Grid.Column="0" Text="输入" />
                        <Button Grid.Column="1" Classes="Quiet" Command="{Binding EncodeCommand}" Content="编码 →" />
                        <Button Grid.Column="2" Classes="Quiet" Command="{Binding DecodeCommand}" Content="← 解码" Margin="6,0,0,0" />
                    </Grid>
                    <TextBox Grid.Row="1" Margin="16,0,16,12" AcceptsReturn="True" TextWrapping="Wrap"
                             Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Classes="ToolCard" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="SectionHeader" Text="输出" Margin="16,12,16,8" />
                    <TextBox Grid.Row="1" Margin="16,0,16,12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="{StaticResource MonoFontFamily}"
                             Text="{Binding OutputText, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>