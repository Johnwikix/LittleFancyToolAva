<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LittleFancyToolAva.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="LittleFancyToolAva.Views.Base64View"
             x:DataType="vm:Base64ViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16" ColumnDefinitions="*,10,*">
            <StackPanel Grid.Column="0" Spacing="10">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Base64 编解码" />

                <Border Padding="12" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="100,*">
                            <TextBlock VerticalAlignment="Center" Text="输入" />
                            <TextBox Grid.Column="1" AcceptsReturn="True" MinHeight="150"
                                     Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Command="{Binding EncodeCommand}" Content="编码 >>" />
                    <Button Command="{Binding DecodeCommand}" Content="解码 &lt;&lt;" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="10">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="输出" />
                <Border Padding="12" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <TextBox IsReadOnly="True" AcceptsReturn="True" MinHeight="150"
                             Text="{Binding OutputText, Mode=OneWay}" />
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
