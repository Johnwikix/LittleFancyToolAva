<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LittleFancyToolAva.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:LittleFancyToolAva.Models"
             mc:Ignorable="d"
             x:Class="LittleFancyToolAva.Views.FolderCompareView"
             x:DataType="vm:FolderCompareViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Spacing="12">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="文件夹比较" />

            <Border Padding="12" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="100,*">
                        <TextBlock VerticalAlignment="Center" Text="源文件夹" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding SelectSourceFolderCommand}" Content="选择文件夹" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding SourceFolder}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="100,*">
                        <TextBlock VerticalAlignment="Center" Text="目标文件夹" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding SelectTargetFolderCommand}" Content="选择文件夹" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding TargetFolder}" />
                        </StackPanel>
                    </Grid>
                    <CheckBox IsChecked="{Binding UseHashComparison}" Content="Hash 比较 (MD5)" />
                    <CheckBox IsChecked="{Binding UseMusicTitleComparison}" Content="音乐标题比较" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Command="{Binding CompareCommand}" Content="开始比较" />
            </StackPanel>

            <Border Padding="12" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="进度" />
                    <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="1" Height="20" />
                    <TextBlock Text="{Binding StatusText}" />
                </StackPanel>
            </Border>

            <Border Padding="12" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="比较结果" />
                    <ItemsControl ItemsSource="{Binding CompareResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:FolderCompareResult">
                                <Border Padding="8" Margin="0,2" CornerRadius="4"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RelativePath}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding State}" FontSize="11" Opacity="0.7" />
                                            <TextBlock Text="{Binding SourceDetail}" FontSize="11" Opacity="0.5" />
                                            <TextBlock Text="{Binding TargetDetail}" FontSize="11" Opacity="0.5" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
