<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="400" d:DesignHeight="400"
             x:Class="LittleFancyToolAva.Views.Dialogs.SystemSetDialog">
    <StackPanel Spacing="16" Margin="16">
        <TextBlock Text="系统设置" FontSize="18" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center" Text="动画" />
            <ToggleSwitch Grid.Column="1" x:Name="AnimationSwitch" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center" Text="阴影" />
            <ToggleSwitch Grid.Column="1" x:Name="ShadowSwitch" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center" Text="隐藏滚动条" />
            <ToggleSwitch Grid.Column="1" x:Name="ScrollBarSwitch" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center" Text="消息窗口中显示" />
            <ToggleSwitch Grid.Column="1" x:Name="MessageInWindowSwitch" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center" Text="通知偏移" />
            <NumericUpDown Grid.Column="1" Width="120" x:Name="OffsetInput" Minimum="0" Maximum="500" />
        </Grid>
    </StackPanel>
</UserControl>
