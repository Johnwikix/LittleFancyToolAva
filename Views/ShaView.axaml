<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LittleFancyToolAva.ViewModels"
             xmlns:controls="using:LittleFancyToolAva.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="LittleFancyToolAva.Views.ShaView"
             x:DataType="vm:ShaViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="{StaticResource PageMargin}">
        <controls:ToolPageHeader Grid.Row="0" Title="SHA 哈希" Subtitle="SHA-1 / SHA-256 / SHA-384 / SHA-512 安全散列算法" />
        <Grid Grid.Row="1" ColumnDefinitions="*,16,*" Margin="0,16,0,0">
            <Grid Grid.Column="0" RowDefinitions="Auto,16,*">
                <Border Grid.Row="0" Classes="ToolCard">
                    <StackPanel Classes="ToolCardContent">
                        <TextBlock Classes="SectionHeader" Text="参数" />
                        <Grid Classes="FormRow2" ColumnDefinitions="80,*,12,80,*">
                            <TextBlock Classes="FieldLabel" Text="算法" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="SHA-1" />
                                <ComboBoxItem Content="SHA-256" />
                                <ComboBoxItem Content="SHA-384" />
                                <ComboBoxItem Content="SHA-512" />
                            </ComboBox>
                            <TextBlock Grid.Column="3" Classes="FieldLabel" Text="大小写" />
                            <ComboBox Grid.Column="4" HorizontalAlignment="Stretch" SelectedIndex="{Binding CaseIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="大写 (UPPER)" />
                                <ComboBoxItem Content="小写 (lower)" />
                            </ComboBox>
                        </Grid>
                        <StackPanel Classes="ActionBar">
                            <Button Command="{Binding EncryptCommand}" Classes="Primary" Content="计算 SHA" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Classes="ToolCard" Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Classes="SectionHeader" Text="输入" Margin="16,12,16,8" />
                        <TextBox Grid.Row="1" Margin="16,0,16,12" AcceptsReturn="True" TextWrapping="Wrap"
                                 Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Column="2" Classes="ToolCard" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="SectionHeader" Text="输出" Margin="16,12,16,8" />
                    <TextBox Grid.Row="1" Margin="16,0,16,12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="{StaticResource MonoFontFamily}"
                             Text="{Binding OutputText, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>