<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LittleFancyToolAva.ViewModels"
             xmlns:views="using:LittleFancyToolAva.Views"
             xmlns:lan="clr-namespace:Lang.Avalonia.MarkupExtensions;assembly=Lang.Avalonia"
             x:Class="LittleFancyToolAva.Views.CommToolView"
             x:DataType="vm:CommToolViewModel">

    <Grid Margin="{StaticResource PageMargin}">
        <TabControl SelectedIndex="0" Padding="0,12,0,0">
            <TabItem Header="{lan:I18n Nav.Item_TCP}">
                <views:TcpServerView DataContext="{Binding TcpVm}" />
            </TabItem>
            <TabItem Header="{lan:I18n Nav.Item_UDP}">
                <views:UdpView DataContext="{Binding UdpVm}" />
            </TabItem>
            <TabItem Header="{lan:I18n Nav.Item_Serial}">
                <views:SerialPortView DataContext="{Binding SerialVm}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>