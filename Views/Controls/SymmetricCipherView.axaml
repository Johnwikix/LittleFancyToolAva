<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:LittleFancyToolAva.Views.Controls"
             xmlns:vm="using:LittleFancyToolAva.ViewModels"
             x:Class="LittleFancyToolAva.Views.Controls.SymmetricCipherView"
             x:DataType="vm:SymmetricCipherViewModelBase">

    <Grid RowDefinitions="Auto,*"
          Margin="{StaticResource PageMargin}">

        <controls:ToolPageHeader Grid.Row="0"
                                 Title="{Binding DisplayTitle}"
                                 Subtitle="{Binding DisplaySubtitle}" />

        <Grid Grid.Row="1" ColumnDefinitions="*,16,*" Margin="0,16,0,0">
            <Grid Grid.Column="0" RowDefinitions="Auto,16,*">
                <Border Grid.Row="0" Classes="ToolCard">
                    <StackPanel Classes="ToolCardContent">
                        <TextBlock Classes="SectionHeader" Text="参数" />
                        <Grid Classes="FormRow2" ColumnDefinitions="*,12,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="FieldLabel" Text="填充模式" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Paddings}"
                                          SelectedIndex="{Binding PaddingIndex, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="FieldLabel" Text="加密模式" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          SelectedIndex="{Binding EncryptModeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="ECB" />
                                    <ComboBoxItem Content="CBC" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Classes="FormRow2" ColumnDefinitions="*,12,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="FieldLabel" Text="输出格式" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          SelectedIndex="{Binding OutputTypeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Base64" />
                                    <ComboBoxItem Content="Hex" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="FieldLabel" Text="Key/IV 格式" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          SelectedIndex="{Binding KeyIvTypeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Text" />
                                    <ComboBoxItem Content="Base64" />
                                    <ComboBoxItem Content="Hex" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <StackPanel Classes="FormRow"
                                    IsEnabled="{Binding IsKeyLengthSelectable}">
                            <TextBlock Classes="FieldLabel" Text="密钥长度 (bits)" />
                            <ComboBox Classes="Compact" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding KeyLengthOptions}"
                                      SelectedIndex="{Binding KeyLengthIndex, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="Key" />
                            <Grid ColumnDefinitions="*,8,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2"
                                        Command="{Binding GenerateNewKeyCommand}"
                                        Content="生成 Key/IV" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Classes="FormRow"
                                    IsEnabled="{Binding EncryptModeIndex, Converter={StaticResource IntEq}, ConverterParameter=1}">
                            <TextBlock Classes="FieldLabel" Text="IV" />
                            <TextBox Text="{Binding Iv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Classes="ToolCard" Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,12,16,8">
                            <TextBlock Classes="SectionHeader" Text="输入" />
                            <Button Grid.Column="1" Classes="Primary"
                                    Command="{Binding EncryptCommand}" Content="加密" />
                        </Grid>
                        <TextBox Grid.Row="1"
                                 Margin="16,0,16,12"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Classes="ToolCard" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,12,16,8">
                        <TextBlock Classes="SectionHeader" Text="输出" />
                        <Button Grid.Column="1" Classes="Danger"
                                Command="{Binding DecryptCommand}" Content="解密" />
                    </Grid>
                    <TextBox Grid.Row="1"
                             Margin="16,0,16,12"
                             IsReadOnly="False" AcceptsReturn="True" TextWrapping="Wrap"
                             Text="{Binding OutputText, Mode=TwoWay}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
