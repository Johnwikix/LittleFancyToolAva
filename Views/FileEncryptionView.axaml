<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LittleFancyToolAva.ViewModels"
             xmlns:controls="using:LittleFancyToolAva.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="LittleFancyToolAva.Views.FileEncryptionView"
             x:DataType="vm:FileEncryptionViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="{StaticResource PageMargin}">
        <controls:ToolPageHeader Grid.Row="0" Title="文件加解密" Subtitle="批量文件 AES 加解密" />
        <Grid Grid.Row="1" ColumnDefinitions="*,16,*" Margin="0,16,0,0">
            <Grid Grid.Column="0" RowDefinitions="Auto,16,*,16,*">
                <!-- File selection -->
                <Border Grid.Row="0" Classes="ToolCard">
                    <StackPanel Classes="ToolCardContent">
                        <TextBlock Classes="SectionHeader" Text="文件" />
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="选择文件" />
                            <Grid ColumnDefinitions="*,8,Auto">
                                <TextBox Grid.Column="0" Text="{Binding SelectedFilesDisplay}" IsReadOnly="True" />
                                <Button Grid.Column="2" Command="{Binding SelectFilesCommand}" Content="选择文件" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="输出目录" />
                            <Grid ColumnDefinitions="*,8,Auto">
                                <TextBox Grid.Column="0" Text="{Binding OutputDirectory}" IsReadOnly="True" />
                                <Button Grid.Column="2" Command="{Binding SelectOutputDirectoryCommand}" Content="选择目录" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Key -->
                <Border Grid.Row="2" Classes="ToolCard">
                    <StackPanel Classes="ToolCardContent">
                        <TextBlock Classes="SectionHeader" Text="密钥" />
                        <Grid Classes="FormRow2" ColumnDefinitions="*,12,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="FieldLabel" Text="Key 长度" />
                                <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding KeyLengthIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="128" />
                                    <ComboBoxItem Content="192" />
                                    <ComboBoxItem Content="256" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Grid ColumnDefinitions="*,8,Auto">
                                    <TextBlock Classes="FieldLabel" Text="IV" />
                                    <Button Grid.Column="2" Command="{Binding GenerateKeyCommand}" Content="生成" Margin="0,0,0,4" />
                                </Grid>
                                <TextBox FontFamily="{StaticResource MonoFontFamily}"
                                         Text="{Binding Iv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="Key" />
                            <TextBox FontFamily="{StaticResource MonoFontFamily}"
                                     Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Progress -->
                <Border Grid.Row="4" Classes="ToolCard" IsVisible="{Binding IsProcessing}">
                    <StackPanel Classes="ToolCardContent">
                        <TextBlock Classes="SectionHeader" Text="进度" />
                        <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="1" Height="8" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Column="2" Classes="ToolCard" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="SectionHeader" Text="输出日志" Margin="16,12,16,8" />
                    <TextBox Grid.Row="1" Margin="16,0,16,12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="{StaticResource MonoFontFamily}"
                             Text="{Binding OutputLog, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Classes="ActionBar">
            <Button Command="{Binding EncryptCommand}" Classes="Primary" Content="加密" />
            <Button Command="{Binding DecryptCommand}" Classes="Danger" Content="解密" />
        </StackPanel>
    </Grid>
</UserControl>