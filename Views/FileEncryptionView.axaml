<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LittleFancyToolAva.ViewModels"
             xmlns:models="using:LittleFancyToolAva.Models"
             xmlns:controls="using:LittleFancyToolAva.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="LittleFancyToolAva.Views.FileEncryptionView"
             x:DataType="vm:FileEncryptionViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="{StaticResource PageMargin}">
        <controls:ToolPageHeader Grid.Row="0" Title="文件加解密" Subtitle="批量文件 AES 加解密" />
        <Grid Grid.Row="1" ColumnDefinitions="3*,16,7*" Margin="0,16,0,0">
            <ScrollViewer Grid.Column="0">
                <Border Classes="ToolCard">
                    <StackPanel Classes="ToolCardContent" Spacing="12">
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="输出目录" />
                            <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <Button Grid.Column="2" Command="{Binding SelectOutputDirectoryCommand}" Content="选择" />
                                <Button Grid.Column="4" Command="{Binding OpenOutputFolderCommand}" Content="打开" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="Key 长度" />
                            <Grid ColumnDefinitions="*,8,Auto">
                                <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                          SelectedIndex="{Binding KeyLengthIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="128" />
                                    <ComboBoxItem Content="192" />
                                    <ComboBoxItem Content="256" />
                                </ComboBox>
                                <Button Grid.Column="2" Command="{Binding GenerateKeyCommand}" Content="生成 Key/IV" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="Key/IV 格式" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      SelectedIndex="{Binding KeyIvTypeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Text" />
                                <ComboBoxItem Content="Base64" />
                                <ComboBoxItem Content="Hex" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="Key" />
                            <TextBox FontFamily="{StaticResource MonoFontFamily}"
                                     Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="IV" />
                            <TextBox FontFamily="{StaticResource MonoFontFamily}"
                                     Text="{Binding Iv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding ExportKeyIvCommand}" Content="导出 Key/IV" />
                            <Button Command="{Binding ImportKeyIvCommand}" Content="导入 Key/IV" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsBusy}" Spacing="4">
                            <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="1" Height="8" />
                            <TextBlock Text="{Binding StatusText}" />
                        </StackPanel>
                        <Button Command="{Binding StartEncryptCommand}" Classes="Primary"
                                HorizontalAlignment="Stretch" Content="开始加密" />
                        <Button Command="{Binding StartDecryptCommand}" Classes="Danger"
                                HorizontalAlignment="Stretch" Content="开始解密" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
            <Border Grid.Column="2" Classes="ToolCard" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,12,16,4">
                        <TextBlock Grid.Column="0" Classes="SectionHeader" Text="{Binding StatusText, FallbackValue='文件列表'}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Command="{Binding AddFilesCommand}" Content="添加文件" />
                            <Button Command="{Binding AddFolderCommand}" Content="添加文件夹" />
                            <Button Command="{Binding ClearListCommand}" Content="清空" />
                        </StackPanel>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding FileItems}"
                             SelectedItem="{Binding SelectedFileItem}"
                             BorderThickness="0" Margin="8,0,8,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:EncryptionFileItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,2">
                                    <SelectableTextBlock Grid.Column="0" Text="📄" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center" />
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding StatusDisplay}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>