<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FancyToolAva.ViewModels"
             xmlns:models="using:FancyToolAva.Models"
             xmlns:controls="using:FancyToolAva.Views.Controls"
             xmlns:lan="clr-namespace:Lang.Avalonia.MarkupExtensions;assembly=Lang.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="FancyToolAva.Views.FileEncryptionView"
             x:DataType="vm:FileEncryptionViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="{StaticResource PageMargin}">
        <controls:ToolPageHeader Grid.Row="0" Title="{lan:I18n FileEnc.Title}" Subtitle="{lan:I18n FileEnc.Subtitle}" />
        <Grid Grid.Row="1" ColumnDefinitions="3*,16,7*" Margin="0,16,0,0">
            <ScrollViewer Grid.Column="0">
                <Border Classes="ToolCard">
                    <StackPanel Classes="ToolCardContent" Spacing="12">
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="{lan:I18n FileEnc.Label_OutputDir}" />
                            <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <Button Grid.Column="2" Command="{Binding SelectOutputDirectoryCommand}" Content="{lan:I18n Common.Button_Select}" />
                                <Button Grid.Column="4" Command="{Binding OpenOutputFolderCommand}" Content="{lan:I18n Common.Button_Open}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="{lan:I18n FileEnc.Label_KeyLength}" />
                            <Grid ColumnDefinitions="*,8,Auto">
                                <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                          SelectedIndex="{Binding KeyLengthIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="128" />
                                    <ComboBoxItem Content="192" />
                                    <ComboBoxItem Content="256" />
                                </ComboBox>
                                <Button Grid.Column="2" Command="{Binding GenerateKeyCommand}" Content="{lan:I18n FileEnc.Button_Generate}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="{lan:I18n FileEnc.Label_KeyIvFormat}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      SelectedIndex="{Binding KeyIvTypeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Text" />
                                <ComboBoxItem Content="Base64" />
                                <ComboBoxItem Content="Hex" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="Key" />
                            <TextBox FontFamily="{StaticResource MonoFontFamily}"
                                     Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="IV" />
                            <TextBox FontFamily="{StaticResource MonoFontFamily}"
                                     Text="{Binding Iv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding ExportKeyIvCommand}" Content="{lan:I18n FileEnc.Button_Export}" />
                            <Button Command="{Binding ImportKeyIvCommand}" Content="{lan:I18n FileEnc.Button_Import}" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsBusy}" Spacing="4">
                            <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="1" Height="8" />
                            <TextBlock Text="{Binding StatusText}" />
                        </StackPanel>
                        <Button Command="{Binding StartEncryptCommand}" Classes="Primary"
                                HorizontalAlignment="Stretch" Content="{lan:I18n FileEnc.Button_StartEncrypt}" />
                        <Button Command="{Binding StartDecryptCommand}" Classes="Danger"
                                HorizontalAlignment="Stretch" Content="{lan:I18n FileEnc.Button_StartDecrypt}" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
            <Border Grid.Column="2" Classes="ToolCard" Padding="0"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragEnter="OnDragEnter"
                    DragDrop.DragOver="OnDragOver"
                    DragDrop.Drop="OnDrop">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,12,16,4">
                        <TextBlock Grid.Column="0" Classes="SectionHeader" Text="{Binding StatusText, FallbackValue='File List'}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Command="{Binding AddFilesCommand}" Content="{lan:I18n FileEnc.Button_AddFiles}" />
                            <Button Command="{Binding AddFolderCommand}" Content="{lan:I18n FileEnc.Button_AddFolder}" />
                            <Button Command="{Binding ClearListCommand}" Content="{lan:I18n FileEnc.Button_Clear}" />
                        </StackPanel>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding FileItems}"
                             SelectedItem="{Binding SelectedFileItem}"
                             BorderThickness="0" Margin="8,0,8,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:EncryptionFileItem">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="4,2">
                                    <SelectableTextBlock Grid.Column="0" Text="📄" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <SelectableTextBlock Text="{Binding StatusDisplay}" />
                                        <SelectableTextBlock Text="{Binding ProgressDisplay}" />
                                    </StackPanel>
                                    <Button Grid.Column="3"
                                            Command="{Binding RemoveCommand}"
                                            Padding="6,2"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ToolTip.Tip="{lan:I18n FileEnc.Tooltip_Remove}"
                                            Content="🗑️" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>