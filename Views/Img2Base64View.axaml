<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FancyToolAva.ViewModels"
             xmlns:controls="using:FancyToolAva.Views.Controls"
             xmlns:lan="clr-namespace:Lang.Avalonia.MarkupExtensions;assembly=Lang.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="FancyToolAva.Views.Img2Base64View"
             x:DataType="vm:Img2Base64ViewModel">
    <Grid RowDefinitions="Auto,*" Margin="{StaticResource PageMargin}">
        <controls:ToolPageHeader Grid.Row="0" Title="{lan:I18n Img2Base64.Title}"
                                Subtitle="{lan:I18n Img2Base64.Subtitle}" />

        <Grid Grid.Row="1" ColumnDefinitions="*,16,*" Margin="0,16,0,0">

            <Border Grid.Column="0" Classes="ToolCard" Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="16,12,16,8">
                        <TextBlock Classes="SectionHeader" Grid.Column="0" Text="{lan:I18n Img2Base64.Group_Preview}" />
                        <Button Grid.Column="1" Command="{Binding UploadImageCommand}" Content="{lan:I18n Img2Base64.Button_Upload}" Margin="0,0,6,0" />
                        <Button Grid.Column="2" Command="{Binding SaveDecodedImageCommand}" Classes="Quiet" Content="{lan:I18n Img2Base64.Button_Save}" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="16,0,16,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Classes="Caption"
                                   Text="{Binding ImagePath}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,8" />
                        <Border Grid.Row="1" Classes="ToolCardTight"
                                DragDrop.AllowDrop="True"
                                DragDrop.DragEnter="OnDragEnter"
                                DragDrop.DragOver="OnDragOver"
                                DragDrop.Drop="OnDrop">
                            <Image Source="{Binding ImagePreview}" Stretch="Uniform" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="2" Classes="ActionBar" Margin="16,0,16,12">
                        <Button Command="{Binding EncodeCommand}" Classes="Primary" Content="{lan:I18n Img2Base64.Button_Encode}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="ToolCard" Padding="0">
                <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Classes="SectionHeader" Text="{lan:I18n Img2Base64.Group_Input}"
                               Margin="16,12,16,8" />
                    <TextBox Grid.Row="1"
                             Margin="16,0,16,8"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="{StaticResource MonoFontFamily}"
                             Text="{Binding Base64Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{lan:I18n Img2Base64.Placeholder_Paste}" />
                    <StackPanel Grid.Row="2" Classes="ActionBar" Margin="16,0,16,4">
                        <Button Command="{Binding DecodeCommand}" Classes="Danger" Content="{lan:I18n Img2Base64.Button_Decode}" />
                        <Button Command="{Binding DecodeFromClipboardCommand}" Classes="Quiet" Content="{lan:I18n Img2Base64.Button_DecodeClipboard}" />
                        <Button Command="{Binding DecodeFromFileCommand}" Classes="Quiet" Content="{lan:I18n Img2Base64.Button_DecodeFile}" />
                    </StackPanel>

                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="16,12,16,4">
                        <TextBlock Classes="SectionHeader" Grid.Column="0" Text="{lan:I18n Img2Base64.Group_Output}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Base64Length}"
                                   Classes="Caption"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Border Grid.Row="4" Classes="ToolCardTight" Margin="16,0,16,4"
                            MinHeight="60" MaxHeight="120" ClipToBounds="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding Base64Preview}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                    <StackPanel Grid.Row="5" Classes="ActionBar" Margin="16,0,16,12">
                        <Button Command="{Binding CopyBase64Command}" Classes="Quiet"
                                Content="{lan:I18n Img2Base64.Button_Copy}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
