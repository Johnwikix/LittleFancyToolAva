<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LittleFancyToolAva.ViewModels"
             xmlns:controls="using:LittleFancyToolAva.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="LittleFancyToolAva.Views.Img2Base64View"
             x:DataType="vm:Img2Base64ViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="{StaticResource PageMargin}">
        <controls:ToolPageHeader Grid.Row="0" Title="图片 ↔ Base64"
                                Subtitle="图片编码为 Base64 字符串，或将 Base64 解码为图片" />

        <Grid Grid.Row="1" ColumnDefinitions="*,16,*" Margin="0,16,0,0">

            <!-- Left column: 图片 → Base64 -->
            <Border Grid.Column="0" Classes="ToolCard" Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,12,16,8">
                        <TextBlock Classes="SectionHeader" Grid.Column="0" Text="图片输入" />
                        <Button Grid.Column="1" Command="{Binding UploadImageCommand}" Content="上传图片" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="16,0,16,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Classes="Caption"
                                   Text="{Binding ImagePath}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,8" />
                        <Border Grid.Row="1" Classes="ToolCardTight">
                            <Image Source="{Binding ImagePreview}" Stretch="Uniform" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="2" Classes="ActionBar" Margin="16,0,16,12">
                        <Button Command="{Binding EncodeCommand}" Classes="Primary" Content="编码为 Base64 →" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right column: Base64 → 图片 -->
            <Border Grid.Column="2" Classes="ToolCard" Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Classes="SectionHeader" Text="Base64 字符串"
                               Margin="16,12,16,8" />
                    <TextBox Grid.Row="1"
                             Margin="16,0,16,8"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="{StaticResource MonoFontFamily}"
                             Text="{Binding Base64Output, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Grid.Row="2" Classes="ActionBar" Margin="16,0,16,12">
                        <Button Command="{Binding DecodeCommand}" Classes="Danger" Content="← 解码 Base64" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0" ColumnDefinitions="*,Auto">
            <Border Grid.Column="0" Classes="ToolCard" Padding="0"
                    IsVisible="{Binding HasDecodedImage}">
                <Grid RowDefinitions="Auto,*" Margin="16,12,16,12">
                    <TextBlock Grid.Row="0" Classes="SectionHeader" Text="解码预览" Margin="0,0,0,8" />
                    <Border Grid.Row="1" Classes="ToolCardTight" MinHeight="160">
                        <Image Source="{Binding DecodedImagePreview}" Stretch="Uniform" />
                    </Border>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Classes="ActionBar" Margin="16,0,0,0" VerticalAlignment="Top">
                <Button Command="{Binding SaveDecodedImageCommand}"
                        Classes="Quiet"
                        Content="保存解码图片"
                        IsEnabled="{Binding HasDecodedImage}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>