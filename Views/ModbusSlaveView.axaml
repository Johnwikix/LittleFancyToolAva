<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LittleFancyToolAva.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="LittleFancyToolAva.Views.ModbusSlaveView"
             x:DataType="vm:ModbusSlaveViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Spacing="10" MaxWidth="900" HorizontalAlignment="Stretch">
            <TextBlock Text="Modbus Slave"
                       FontSize="22"
                       FontWeight="SemiBold" />

            <Border Padding="12" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="连接设置" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid ColumnDefinitions="80,*,10,80,*">
                        <TextBlock VerticalAlignment="Center" Text="串口" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding PortNames}"
                                  SelectedItem="{Binding SelectedPort, Mode=TwoWay}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="波特率" />
                        <ComboBox Grid.Column="4"
                                  ItemsSource="{Binding BaudRates}"
                                  SelectedIndex="{Binding BaudRateIndex, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="80,*,10,80,*">
                        <TextBlock VerticalAlignment="Center" Text="校验位" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Parities}"
                                  SelectedIndex="{Binding ParityIndex, Mode=TwoWay}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="数据位" />
                        <ComboBox Grid.Column="4"
                                  ItemsSource="{Binding DataBitsList}"
                                  SelectedIndex="{Binding DataBitsIndex, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="80,*,10,80,*">
                        <TextBlock VerticalAlignment="Center" Text="停止位" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding StopBitsList}"
                                  SelectedIndex="{Binding StopBitsIndex, Mode=TwoWay}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="Slave ID" />
                        <TextBox Grid.Column="4" Text="{Binding SlaveId, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="80,*,10,80,*">
                        <TextBlock VerticalAlignment="Center" Text="线圈数" />
                        <TextBox Grid.Column="1" Text="{Binding CoilCount, Mode=TwoWay}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="寄存器数" />
                        <TextBox Grid.Column="4" Text="{Binding RegisterCount, Mode=TwoWay}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding StartCommand}" Content="启动"
                                IsEnabled="{Binding IsRunning, Converter={x:Static conv:BoolConverters.Not}}" />
                        <Button Command="{Binding StopCommand}" Content="停止"
                                IsEnabled="{Binding IsRunning}" />
                        <Button Command="{Binding RefreshPortsCommand}" Content="刷新端口" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,10,*">
                <Border Grid.Column="0" Padding="12" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="线圈 (Coils)" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,*,*,*">
                            <Border Padding="8,4" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <TextBlock Text="索引" FontWeight="SemiBold" />
                            </Border>
                            <Border Grid.Column="1" Padding="8,4" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <TextBlock Text="状态" FontWeight="SemiBold" />
                            </Border>
                            <Border Grid.Column="2" Padding="8,4" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <TextBlock Text="启用" FontWeight="SemiBold" />
                            </Border>
                            <Border Grid.Column="3" Padding="8,4" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <TextBlock Text="更新" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Coils}" MaxHeight="200">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,*,*,*">
                                        <TextBlock Padding="8,2" Text="{Binding Address}" />
                                        <TextBlock Grid.Column="1" Padding="8,2" Text="{Binding Value}" />
                                        <TextBlock Grid.Column="2" Padding="8,2" Text="{Binding Enabled}" />
                                        <TextBlock Grid.Column="3" Padding="8,2" Text="{Binding LastUpdate}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="12" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="保持寄存器 (Holding Registers)" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,*,*,*">
                            <Border Padding="8,4" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <TextBlock Text="索引" FontWeight="SemiBold" />
                            </Border>
                            <Border Grid.Column="1" Padding="8,4" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <TextBlock Text="值" FontWeight="SemiBold" />
                            </Border>
                            <Border Grid.Column="2" Padding="8,4" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <TextBlock Text="启用" FontWeight="SemiBold" />
                            </Border>
                            <Border Grid.Column="3" Padding="8,4" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <TextBlock Text="更新" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding HoldingRegisters}" MaxHeight="200">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,*,*,*">
                                        <TextBlock Padding="8,2" Text="{Binding Address}" />
                                        <TextBlock Grid.Column="1" Padding="8,2" Text="{Binding Value}" />
                                        <TextBlock Grid.Column="2" Padding="8,2" Text="{Binding Enabled}" />
                                        <TextBlock Grid.Column="3" Padding="8,2" Text="{Binding LastUpdate}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Padding="12" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="写入控制" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid ColumnDefinitions="80,*,Auto">
                        <TextBlock VerticalAlignment="Center" Text="线圈索引" />
                        <TextBox Grid.Column="1" Text="{Binding SelectedCoilIndex, Mode=TwoWay}" />
                        <CheckBox Grid.Column="2" Content="ON" IsChecked="{Binding SelectedCoilValue, Mode=TwoWay}"
                                  Margin="8,0,0,0" />
                    </Grid>
                    <Button Command="{Binding UpdateCoilCommand}" Content="更新线圈" HorizontalAlignment="Right" />
                    <Grid ColumnDefinitions="80,*,80,*">
                        <TextBlock VerticalAlignment="Center" Text="寄存器索引" />
                        <TextBox Grid.Column="1" Text="{Binding SelectedRegisterIndex, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="值" />
                        <TextBox Grid.Column="3" Text="{Binding SelectedRegisterValue, Mode=TwoWay}" />
                    </Grid>
                    <Button Command="{Binding UpdateRegisterCommand}" Content="更新寄存器" HorizontalAlignment="Right" />
                </StackPanel>
            </Border>

            <Border Padding="12" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="日志" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Command="{Binding ClearLogCommand}" Content="清空" FontSize="12" />
                    </Grid>
                    <TextBox IsReadOnly="True" AcceptsReturn="True" MinHeight="120"
                             Text="{Binding LogText, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Padding="12" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <TextBlock Text="{Binding StatusText}" Opacity="0.7" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
