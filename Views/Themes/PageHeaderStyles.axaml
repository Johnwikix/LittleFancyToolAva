<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:FancyToolAva.Views.Controls">

    <LinearGradientBrush StartPoint="0,0"
                         EndPoint="0%,100%"
                         x:Key="HeaderOpacityMaskBrush">
        <GradientStop Color="#FF000000" Offset="0" />
        <GradientStop Color="#FF000000" Offset="0.8" />
        <GradientStop Color="#EE000000" Offset="0.83" />
        <GradientStop Color="#DD000000" Offset="0.86" />
        <GradientStop Color="#BB000000" Offset="0.89" />
        <GradientStop Color="#85000000" Offset="0.92" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush Color="Black" x:Key="PageHeaderForegroundBrush" />

            <ImageBrush x:Key="PageHeaderBackgroundBrush"
                        Source="avares://FancyToolAva/Assets/Images/HeaderBackgroundLight.png"
                        AlignmentY="Center"
                        Stretch="UniformToFill" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush Color="White" x:Key="PageHeaderForegroundBrush" />

            <ImageBrush x:Key="PageHeaderBackgroundBrush"
                        Source="avares://FancyToolAva/Assets/Images/HeaderBackgroundDark.png"
                        AlignmentY="Center"
                        Stretch="UniformToFill" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <ControlTheme TargetType="controls:PageHeaderControl"
                  x:Key="{x:Type controls:PageHeaderControl}">
        <Setter Property="Height" Value="296" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border CornerRadius="8,0,0,0"
                            ClipToBounds="True"
                            Background="{DynamicResource PageHeaderBackgroundBrush}"
                            RenderOptions.BitmapInterpolationMode="HighQuality"
                            OpacityMask="{DynamicResource HeaderOpacityMaskBrush}" />

                    <Panel>
                        <Viewbox MaxWidth="300"
                                 Margin="30"
                                 MinWidth="150"
                                 VerticalAlignment="Top"
                                 HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Header}"
                                           Foreground="{DynamicResource PageHeaderForegroundBrush}"
                                           Theme="{StaticResource TitleLargeTextBlockStyle}" />
                                <TextBlock Text="{TemplateBinding SubTitle}"
                                           Foreground="{DynamicResource PageHeaderForegroundBrush}"
                                           FontSize="18"
                                           Name="SubTitleText"
                                           IsVisible="False" />
                            </StackPanel>
                        </Viewbox>
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:subtitle /template/ TextBlock#SubTitleText">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
