<!-- TODO: 待完善 — 功能可用但暂不启用，后续可完善后重新接入导航 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LittleFancyToolAva.ViewModels"
             xmlns:controls="using:LittleFancyToolAva.Views.Controls"
             xmlns:models="using:LittleFancyToolAva.Models"
             xmlns:helpers="using:LittleFancyToolAva.Helpers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="LittleFancyToolAva.Views.ModbusPollView"
             x:DataType="vm:ModbusPollViewModel">

    <UserControl.Resources>
        <helpers:InverseBoolConverter x:Key="Inv" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
          Margin="{StaticResource PageMargin}">

        <controls:ToolPageHeader Grid.Row="0"
                                Title="Modbus Poll"
                                Subtitle="Modbus 主站轮询调试，支持 FC01-04">
            <controls:ToolPageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <controls:StatusPill Status="{Binding ConnectionStatus}"
                                         Text="{Binding ConnectionStatus, Converter={StaticResource StatusTextConverter}}"
                                         Detail="{Binding StatusDetail}" />
                </StackPanel>
            </controls:ToolPageHeader.Actions>
        </controls:ToolPageHeader>

        <!-- Compact connection bar (single row) -->
        <Border Grid.Row="1" Classes="ToolRow" Margin="0,8,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*,Auto,*,Auto,Auto,Auto">
                <TextBlock Classes="FieldLabel" Grid.Column="0" Text="串口" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" Classes="Compact" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding PortNames}" SelectedItem="{Binding SelectedPort, Mode=TwoWay}" />
                <TextBlock Classes="FieldLabel" Grid.Column="2" Text="波特率" VerticalAlignment="Center" Margin="12,0,8,0" />
                <ComboBox Grid.Column="3" Classes="Compact" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding BaudRates}" SelectedIndex="{Binding BaudRateIndex, Mode=TwoWay}" />
                <TextBlock Classes="FieldLabel" Grid.Column="4" Text="校验" VerticalAlignment="Center" Margin="12,0,8,0" />
                <ComboBox Grid.Column="5" Classes="Compact" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Parities}" SelectedIndex="{Binding ParityIndex, Mode=TwoWay}" />
                <TextBlock Classes="FieldLabel" Grid.Column="6" Text="数据" VerticalAlignment="Center" Margin="12,0,8,0" />
                <ComboBox Grid.Column="7" Classes="Compact" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding DataBitsList}" SelectedIndex="{Binding DataBitsIndex, Mode=TwoWay}" />
                <TextBlock Classes="FieldLabel" Grid.Column="8" Text="停止" VerticalAlignment="Center" Margin="12,0,8,0" />
                <ComboBox Grid.Column="9" Classes="Compact" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding StopBitsList}" SelectedIndex="{Binding StopBitsIndex, Mode=TwoWay}" />
                <StackPanel Grid.Column="10" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Classes="Compact" Command="{Binding RefreshPortsCommand}" Content="刷新" />
                    <Button Classes="Compact Primary" Command="{Binding ConnectCommand}" Content="连接"
                            IsEnabled="{Binding IsConnected, Converter={StaticResource Inv}}" />
                    <Button Classes="Compact Danger" Command="{Binding DisconnectCommand}" Content="断开"
                            IsEnabled="{Binding IsConnected}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Poll parameters (single row) -->
        <Border Grid.Row="2" Classes="ToolRow" Margin="0,8,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Classes="FieldLabel" Grid.Column="0" Text="功能码" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" Classes="Compact" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding FunctionCodes}" SelectedIndex="{Binding FunctionCodeIndex, Mode=TwoWay}" />
                <TextBlock Classes="FieldLabel" Grid.Column="2" Text="从站" VerticalAlignment="Center" Margin="12,0,8,0" />
                <TextBox Grid.Column="3" Classes="Compact" Text="{Binding SlaveId, Mode=TwoWay}" Width="80" />
                <TextBlock Classes="FieldLabel" Grid.Column="4" Text="起始" VerticalAlignment="Center" Margin="12,0,8,0" />
                <TextBox Grid.Column="5" Classes="Compact" Text="{Binding StartAddress, Mode=TwoWay}" Width="80" />
                <TextBlock Classes="FieldLabel" Grid.Column="6" Text="数量" VerticalAlignment="Center" Margin="12,0,8,0" />
                <TextBox Grid.Column="7" Classes="Compact" Text="{Binding Quantity, Mode=TwoWay}" Width="80" />
                <TextBlock Classes="FieldLabel" Grid.Column="8" Text="间隔 ms" VerticalAlignment="Center" Margin="12,0,8,0" />
                <TextBox Grid.Column="9" Classes="Compact" Text="{Binding ScanTime, Mode=TwoWay}" Width="80" />
                <StackPanel Grid.Column="10" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Classes="Compact Primary" Command="{Binding StartPollCommand}" Content="开始轮询"
                            IsEnabled="{Binding IsPolling, Converter={StaticResource Inv}}" />
                    <Button Classes="Compact Danger" Command="{Binding StopPollCommand}" Content="停止"
                            IsEnabled="{Binding IsPolling}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Data table — takes remaining space, virtualized via ListBox -->
        <Border Grid.Row="3" Classes="ToolCard" Margin="0,8,0,0" Padding="0">
            <Grid RowDefinitions="Auto,Auto,*">
                <TextBlock Grid.Row="0" Classes="SectionHeader" Text="数据表" Margin="16,12,16,4" />
                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="16,0,16,4">
                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <TextBlock FontWeight="SemiBold" Text="地址" />
                    </Border>
                    <Border Grid.Column="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <TextBlock FontWeight="SemiBold" Text="值 (Dec)" />
                    </Border>
                    <Border Grid.Column="2" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <TextBlock FontWeight="SemiBold" Text="值 (Hex)" />
                    </Border>
                    <Border Grid.Column="3" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <TextBlock FontWeight="SemiBold" Text="更新时间" />
                    </Border>
                </Grid>
                <ListBox Grid.Row="2" Margin="8,0,8,8"
                         ItemsSource="{Binding PollRows}"
                         SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:PollTableRow">
                            <Grid ColumnDefinitions="*,*,*,*">
                                <TextBlock Padding="8,4" Text="{Binding Address}" />
                                <TextBlock Grid.Column="1" Padding="8,4" Text="{Binding ValueDec}" />
                                <TextBlock Grid.Column="2" Padding="8,4" Text="{Binding ValueHex}" />
                                <TextBlock Grid.Column="3" Padding="8,4" Text="{Binding LastUpdate}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Write + Log side by side -->
        <Grid Grid.Row="4" ColumnDefinitions="*,8,2*" Margin="0,8,0,0">
            <Border Grid.Column="0" Classes="ToolCard">
                <StackPanel Classes="ToolCardContent">
                    <TextBlock Classes="SectionHeader" Text="写入" />
<Grid Classes="FormRow2" ColumnDefinitions="*,12,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="FieldLabel" Text="地址" />
                                <TextBox Classes="Compact" Text="{Binding WriteAddress, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="FieldLabel" Text="值" />
                                <TextBox Classes="Compact" Text="{Binding WriteValue, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    <StackPanel Classes="ActionBar">
                        <Button Classes="Compact" Command="{Binding WriteCoilCommand}" Content="写线圈" />
                        <Button Classes="Compact" Command="{Binding WriteRegisterCommand}" Content="写寄存器" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="ToolCard" Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,12,16,4">
                        <TextBlock Classes="SectionHeader" Grid.Column="0" Text="日志" />
                        <Button Grid.Column="1" Classes="Quiet Compact"
                                Command="{Binding ClearLogCommand}" Content="清空" />
                    </Grid>
                    <controls:LogBufferView Grid.Row="1" Margin="8,0,8,0" Entries="{Binding Log.Entries}" />
                    <Border Grid.Row="2" Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                            Padding="16,6" Margin="8,0,8,12" CornerRadius="4">
                        <TextBlock Classes="Caption">
                            <Run Text="缓冲区: " />
                            <Run Text="{Binding Log.Count}" />
                            <Run Text=" / " />
                            <Run Text="{Binding Log.MaxLines}" />
                            <Run Text=" 行" />
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <controls:TerminalStatusBar Grid.Row="5"
                                    RxCount="0"
                                    Margin="0,10,0,0"
                                    TxCount="{Binding TxCount}"
                                    ErrorCount="{Binding ErrorCount}"
                                    ElapsedText="{Binding ElapsedText}"
                                    RightDetail="{Binding StatusText}" />
    </Grid>
</UserControl>