<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LittleFancyToolAva.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="LittleFancyToolAva.Views.ModbusPollView"
             x:DataType="vm:ModbusPollViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Spacing="10" MaxWidth="900" HorizontalAlignment="Stretch">
            <TextBlock Text="Modbus Poll"
                       FontSize="22"
                       FontWeight="SemiBold" />

            <Border Padding="12" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="连接设置" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid ColumnDefinitions="80,*,10,80,*">
                        <TextBlock VerticalAlignment="Center" Text="串口" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding PortNames}"
                                  SelectedItem="{Binding SelectedPort, Mode=TwoWay}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="波特率" />
                        <ComboBox Grid.Column="4"
                                  ItemsSource="{Binding BaudRates}"
                                  SelectedIndex="{Binding BaudRateIndex, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="80,*,10,80,*">
                        <TextBlock VerticalAlignment="Center" Text="校验位" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Parities}"
                                  SelectedIndex="{Binding ParityIndex, Mode=TwoWay}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="数据位" />
                        <ComboBox Grid.Column="4"
                                  ItemsSource="{Binding DataBitsList}"
                                  SelectedIndex="{Binding DataBitsIndex, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="80,*,10,80,*">
                        <TextBlock VerticalAlignment="Center" Text="停止位" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding StopBitsList}"
                                  SelectedIndex="{Binding StopBitsIndex, Mode=TwoWay}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" />
                        <Button Grid.Column="4" Command="{Binding ConnectCommand}" Content="连接"
                                IsEnabled="{Binding IsConnected, Converter={x:Static conv:BoolConverters.Not}}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding DisconnectCommand}" Content="断开"
                                IsEnabled="{Binding IsConnected}" />
                        <Button Command="{Binding RefreshPortsCommand}" Content="刷新端口" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="12" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="轮询参数" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid ColumnDefinitions="80,*,10,80,*">
                        <TextBlock VerticalAlignment="Center" Text="功能码" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding FunctionCodes}"
                                  SelectedIndex="{Binding FunctionCodeIndex, Mode=TwoWay}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="Slave ID" />
                        <TextBox Grid.Column="4" Text="{Binding SlaveId, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="80,*,10,80,*">
                        <TextBlock VerticalAlignment="Center" Text="起始地址" />
                        <TextBox Grid.Column="1" Text="{Binding StartAddress, Mode=TwoWay}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="数量" />
                        <TextBox Grid.Column="4" Text="{Binding Quantity, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="80,*,Auto,Auto">
                        <TextBlock VerticalAlignment="Center" Text="扫描间隔(ms)" />
                        <TextBox Grid.Column="1" Text="{Binding ScanTime, Mode=TwoWay}" />
                        <Button Grid.Column="2" Command="{Binding StartPollCommand}" Content="开始轮询"
                                IsEnabled="{Binding IsPolling, Converter={x:Static conv:BoolConverters.Not}}"
                                Margin="8,0,0,0" />
                        <Button Grid.Column="3" Command="{Binding StopPollCommand}" Content="停止轮询"
                                IsEnabled="{Binding IsPolling}" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="12" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="数据表" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid ColumnDefinitions="*,*,*,*">
                        <Border Padding="8,4" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <TextBlock Text="地址" FontWeight="SemiBold" />
                        </Border>
                        <Border Grid.Column="1" Padding="8,4" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <TextBlock Text="值(Dec)" FontWeight="SemiBold" />
                        </Border>
                        <Border Grid.Column="2" Padding="8,4" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <TextBlock Text="值(Hex)" FontWeight="SemiBold" />
                        </Border>
                        <Border Grid.Column="3" Padding="8,4" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <TextBlock Text="更新时间" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding PollRows}" MaxHeight="300">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,*,*,*">
                                    <TextBlock Padding="8,2" Text="{Binding Address}" />
                                    <TextBlock Grid.Column="1" Padding="8,2" Text="{Binding ValueDec}" />
                                    <TextBlock Grid.Column="2" Padding="8,2" Text="{Binding ValueHex}" />
                                    <TextBlock Grid.Column="3" Padding="8,2" Text="{Binding LastUpdate}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="12" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="写入" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid ColumnDefinitions="80,*,10,80,*">
                        <TextBlock VerticalAlignment="Center" Text="地址" />
                        <TextBox Grid.Column="1" Text="{Binding WriteAddress, Mode=TwoWay}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="值" />
                        <TextBox Grid.Column="4" Text="{Binding WriteValue, Mode=TwoWay}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding WriteCoilCommand}" Content="写线圈" />
                        <Button Command="{Binding WriteRegisterCommand}" Content="写寄存器" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="12" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="日志" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Command="{Binding ClearLogCommand}" Content="清空" FontSize="12" />
                    </Grid>
                    <TextBox IsReadOnly="True" AcceptsReturn="True" MinHeight="120"
                             Text="{Binding LogText, Mode=OneWay}" />
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="{Binding TxCount, StringFormat='TX: {0}'}" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="1" Text="{Binding ErrorCount, StringFormat='错误: {0}'}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="12" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <TextBlock Text="{Binding StatusText}" Opacity="0.7" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
