<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LittleFancyToolAva.ViewModels"
             xmlns:controls="using:LittleFancyToolAva.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="LittleFancyToolAva.Views.ImgConvertView"
             x:DataType="vm:ImgConvertViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="{StaticResource PageMargin}">
        <controls:ToolPageHeader Grid.Row="0" Title="图片格式转换" Subtitle="PNG / JPG / WebP / BMP 等格式互转" />
        <Grid Grid.Row="1" ColumnDefinitions="*,16,*" Margin="0,16,0,0">
            <Grid Grid.Column="0" RowDefinitions="Auto,16,*">
                <Border Grid.Row="0" Classes="ToolCard">
                    <StackPanel Classes="ToolCardContent">
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="源图片" />
                            <Grid ColumnDefinitions="*,8,Auto">
                                <TextBox Grid.Column="0" Text="{Binding ImagePath}" IsReadOnly="True" />
                                <Button Grid.Column="2" Command="{Binding UploadImageCommand}" Content="上传" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="目标格式" />
                            <Grid ColumnDefinitions="*,8,Auto">
                                <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding AvailableFormats}"
                                          SelectedIndex="{Binding FormatIndex, Mode=TwoWay}" />
                                <Button Grid.Column="2" Command="{Binding ConvertAndSaveCommand}" Classes="Primary" Content="转换并保存" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Classes="ToolCard" Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Classes="SectionHeader" Text="源图预览" Margin="16,12,16,4" />
                        <Border Grid.Row="1" Classes="ToolCardTight" Margin="16,0,16,12" MinHeight="200">
                            <Image Source="{Binding ImagePreview}" Stretch="Uniform" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Column="2" Classes="ToolCard" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="SectionHeader" Text="转换预览" Margin="16,12,16,4" />
                    <Border Grid.Row="1" Classes="ToolCardTight" Margin="16,0,16,12" MinHeight="200">
                        <Image Source="{Binding ImagePreview}" Stretch="Uniform" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>