<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LittleFancyToolAva.ViewModels"
             xmlns:models="using:LittleFancyToolAva.Models"
             xmlns:controls="using:LittleFancyToolAva.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="LittleFancyToolAva.Views.ImgConvertView"
             x:DataType="vm:ImgConvertViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="{StaticResource PageMargin}">
        <controls:ToolPageHeader Grid.Row="0" Title="图片格式转换" Subtitle="PNG / JPG / WebP / BMP 等格式批量转换" />
        <Grid Grid.Row="1" ColumnDefinitions="3*,16,7*" Margin="0,16,0,0">
            <ScrollViewer Grid.Column="0">
                <Border Classes="ToolCard">
                    <StackPanel Classes="ToolCardContent" Spacing="12">
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="输出目录" />
                            <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding OutputFolder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <Button Grid.Column="2" Command="{Binding PickOutputFolderCommand}" Content="选择" />
                                <Button Grid.Column="4" Command="{Binding OpenOutputFolderCommand}" Content="打开" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="目标格式" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding AvailableFormats}"
                                      SelectedIndex="{Binding FormatIndex, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="降采样" />
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsDownscaleEnabled}" Content="启用" />
                                    <ComboBox Grid.Column="2" IsVisible="{Binding IsDownscaleEnabled}"
                                              ItemsSource="{Binding AvailableFilters}"
                                              SelectedIndex="{Binding SelectedFilterIndex}" Width="120" />
                                </Grid>
                                <StackPanel IsVisible="{Binding IsDownscaleEnabled}" Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <Slider Grid.Column="0" Minimum="10" Maximum="100"
                                                Value="{Binding DownscalePercent}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DownscalePercent, StringFormat='{}{0}%'}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsBusy}" Spacing="4">
                            <ProgressBar Value="{Binding ConversionProgress}" Minimum="0" Maximum="1" Height="8" />
                            <TextBlock Text="{Binding StatusText}" />
                        </StackPanel>
                        <Button Command="{Binding StartConvertCommand}" Classes="Primary"
                                HorizontalAlignment="Stretch" Content="开始批量转换" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
            <Border Grid.Column="2" Classes="ToolCard" Padding="0"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragEnter="OnDragEnter"
                    DragDrop.DragOver="OnDragOver"
                    DragDrop.Drop="OnDrop">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,12,16,4">
                        <TextBlock Grid.Column="0" Classes="SectionHeader" Text="{Binding StatusText, FallbackValue='文件列表'}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Command="{Binding AddFilesCommand}" Content="添加文件" />
                            <Button Command="{Binding AddFolderCommand}" Content="添加文件夹" />
                            <Button Command="{Binding ClearListCommand}" Content="清空" />
                        </StackPanel>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding FileItems}"
                             SelectedItem="{Binding SelectedFileItem}"
                             BorderThickness="0" Margin="8,0,8,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ConvertFileItem">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="4,2">
                                    <SelectableTextBlock Grid.Column="0" Text="🖼" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center" />
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding StatusDisplay}" VerticalAlignment="Center" />
                                    <Button Grid.Column="3"
                                            Command="{Binding $parent[ListBox].((vm:ImgConvertViewModel)DataContext).RemoveFileCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="6,2"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ToolTip.Tip="移除"
                                            Content="🗑️" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
