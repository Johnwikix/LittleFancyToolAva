<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="ARM" />
    <Platform Name="ARM64" />
    <Platform Name="x64" />
    <Platform Name="x86" />
  </Configurations>
  <Project Path="../FancyToolAva.Msix/FancyToolAva.Msix.wapproj" Type="c7167f0d-bc9f-4e6e-afe1-012c56b48db5" Id="a090bf52-7c87-42f0-82a5-a4fd557df3ce">
    <Deploy />
  </Project>
  <Project Path="FancyToolAva.csproj">
    <Platform Solution="*|x64" Project="x64" />
  </Project>
  <!-- 库工程在解决方案 x64 配置下仍按 AnyCPU 构建，与各引用方的
       SetPlatform="Platform=AnyCPU" 保持同一套中间目录，避免 obj\x64 期望落空（CS0006）。 -->
  <Project Path="FancyTool.Core\FancyTool.Core.csproj">
    <Platform Solution="*|x64" Project="AnyCPU" />
  </Project>
  <Project Path="FancyTool.Cli\FancyTool.Cli.csproj">
    <Platform Solution="*|x64" Project="x64" />
  </Project>
</Solution>
