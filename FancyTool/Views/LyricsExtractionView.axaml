<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FancyToolAva.ViewModels" xmlns:models="using:FancyToolAva.Models"
             xmlns:controls="using:FancyToolAva.Views.Controls"
             xmlns:lan="clr-namespace:Lang.Avalonia.MarkupExtensions;assembly=Lang.Avalonia"
             x:Class="FancyToolAva.Views.LyricsExtractionView" x:DataType="vm:LyricsExtractionViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="{StaticResource PageMargin}">
    <controls:ToolPageHeader Title="{lan:I18n Lyrics.Title}" Subtitle="{lan:I18n Lyrics.Subtitle}" />
    <Grid Grid.Row="1" ColumnDefinitions="340,16,*" Margin="0,12,0,0">
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <Border Classes="ToolCard">
          <StackPanel Classes="ToolCardContent" Spacing="12">
            <TextBlock Classes="SectionHeader" Text="{lan:I18n Lyrics.Label_Settings}" />
            <StackPanel IsEnabled="{Binding IsIdle}" Spacing="10">
              <TextBlock Classes="FieldLabel" Text="{lan:I18n Lyrics.Label_Language}" />
              <ComboBox ItemsSource="{Binding LanguageLabels}" SelectedIndex="{Binding LanguageIndex}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="LyricsLanguage" />
              <TextBlock Classes="FieldLabel" Text="{lan:I18n Lyrics.Label_Profile}" />
              <ComboBox ItemsSource="{Binding PerformanceLabels}" SelectedIndex="{Binding PerformanceIndex}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="LyricsProfile" />
              <TextBlock Text="{Binding ProfileHint}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <CheckBox IsChecked="{Binding Options.UseGpu}" Content="{lan:I18n Lyrics.Option_Gpu}" AutomationProperties.AutomationId="LyricsGpu" />
              <CheckBox IsChecked="{Binding Options.SongMode}" Content="{lan:I18n Lyrics.Option_Song}" />
              <CheckBox IsChecked="{Binding Options.PreferExisting}" Content="{lan:I18n Lyrics.Option_Existing}" />
              <TextBlock Classes="FieldLabel" Text="{lan:I18n Lyrics.Label_Formats}" />
              <WrapPanel>
                <CheckBox IsChecked="{Binding Lrc}" Content="LRC" Margin="0,0,14,0" />
                <CheckBox IsChecked="{Binding Srt}" Content="SRT" Margin="0,0,14,0" />
                <CheckBox IsChecked="{Binding Krc}" Content="KRC" Margin="0,0,14,0" />
                <CheckBox IsChecked="{Binding Qrc}" Content="QRC" Margin="0,0,14,0" />
                <CheckBox IsChecked="{Binding EnhancedLrc}" Content="ELRC" Margin="0,0,14,0" />
                <CheckBox IsChecked="{Binding Yrc}" Content="YRC" Margin="0,0,14,0" />
                <CheckBox IsChecked="{Binding Vtt}" Content="VTT" Margin="0,0,14,0" />
                <CheckBox IsChecked="{Binding Ass}" Content="ASS" Margin="0,0,14,0" />
                <CheckBox IsChecked="{Binding Text}" Content="TXT" Margin="0,0,14,0" />
                <CheckBox IsChecked="{Binding Json}" Content="JSON" Margin="0,0,14,0" />
              </WrapPanel>
              <TextBlock Text="{lan:I18n Lyrics.Hint_Formats}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <TextBlock Classes="FieldLabel" Text="{lan:I18n Lyrics.Label_Output}" />
              <Grid ColumnDefinitions="*,8,Auto">
                <TextBox Text="{Binding Options.OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="LyricsOutput" />
                <Button Grid.Column="2" Content="{lan:I18n Common.Button_Select}" Command="{Binding PickOutputCommand}" />
              </Grid>
              <Expander Header="{lan:I18n Lyrics.Label_Advanced}" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8">
                  <TextBlock Text="{lan:I18n Lyrics.Label_Models}" />
                  <TextBox Text="{Binding Options.ModelDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="LyricsModels" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{lan:I18n Common.Button_Select}" Command="{Binding PickModelsCommand}" />
                    <Button Content="{lan:I18n Lyrics.Button_Prepare}" Command="{Binding PrepareModelsCommand}" />
                  </StackPanel>
                  <TextBlock Text="{lan:I18n Lyrics.Label_Chunk}" />
                  <NumericUpDown Value="{Binding Options.ChunkSeconds}" Minimum="10" Maximum="60" FormatString="0" />
                  <TextBlock Text="{lan:I18n Lyrics.Label_LineLength}" />
                  <NumericUpDown Value="{Binding Options.MaxLineCharacters}" Minimum="8" Maximum="120" FormatString="0" />
                </StackPanel>
              </Expander>
            </StackPanel>
            <Button Classes="Primary" HorizontalAlignment="Stretch" Content="{lan:I18n Lyrics.Button_Start}" Command="{Binding StartCommand}" AutomationProperties.AutomationId="LyricsStart" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
              <Button Content="{Binding PauseLabel}" Command="{Binding TogglePauseCommand}" IsVisible="{Binding CanPause}" />
              <Button Content="{lan:I18n Common.Button_Cancel}" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="LyricsCancel" />
            </StackPanel>
            <ProgressBar Value="{Binding BatchProgress}" Minimum="0" Maximum="1" Height="6" IsVisible="{Binding IsBusy}" />
          </StackPanel>
        </Border>
      </ScrollViewer>
      <Grid Grid.Column="2" RowDefinitions="*,14,*">
        <Border Classes="ToolCard" Padding="12" DragDrop.AllowDrop="True" DragDrop.DragOver="OnDragOver" DragDrop.Drop="OnDrop">
          <Grid RowDefinitions="Auto,Auto,*">
            <WrapPanel>
              <Button Content="{lan:I18n Lyrics.Button_AddFiles}" Command="{Binding AddFilesCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="LyricsAddFiles" />
              <Button Content="{lan:I18n Lyrics.Button_AddFolder}" Command="{Binding AddFolderCommand}" Margin="0,0,8,8" />
              <Button Content="{lan:I18n Common.Button_Remove}" Command="{Binding RemoveCommand}" Margin="0,0,8,8" />
              <Button Content="{lan:I18n Common.Button_Clear}" Command="{Binding ClearCommand}" Margin="0,0,0,8" />
            </WrapPanel>
            <TextBlock Grid.Row="1" Text="{Binding QueueSummary}" Margin="0,0,0,8" FontSize="12" />
            <Grid Grid.Row="2">
              <ListBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" AutomationProperties.AutomationId="LyricsQueue">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:LyricsTaskItem">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" Margin="0,4">
                      <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourceFile}" />
                      <TextBlock Grid.Column="1" Text="{Binding Elapsed}" FontSize="11" Margin="8,0,0,0" />
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Stage}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Error}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="{lan:I18n Lyrics.Hint_Drop}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !Tasks.Count}" TextWrapping="Wrap" MaxWidth="320" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
          </Grid>
        </Border>
        <GridSplitter Grid.Row="1" Height="6" VerticalAlignment="Center" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
        <Border Grid.Row="2" Classes="ToolCard" Padding="12">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <WrapPanel>
              <TextBlock Text="{lan:I18n Lyrics.Label_Preview}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,8" />
              <Button Content="{lan:I18n Lyrics.Button_Import}" Command="{Binding ImportLyricsCommand}" Margin="0,0,8,8" />
              <Button Content="{lan:I18n Lyrics.Button_Listen}" Command="{Binding ListenCommand}" Margin="0,0,8,8" />
              <Button Content="{lan:I18n Lyrics.Button_OpenOutput}" Command="{Binding OpenOutputCommand}" Margin="0,0,0,8" />
            </WrapPanel>
            <TextBlock Grid.Row="1" Text="{Binding PreviewInfo}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
            <TextBox Grid.Row="2" Text="{Binding EditorText}" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="{StaticResource MonoFontFamily}" IsEnabled="{Binding IsIdle}" PlaceholderText="{lan:I18n Lyrics.Hint_Editor}" AutomationProperties.AutomationId="LyricsEditor" />
            <WrapPanel Grid.Row="3" Margin="0,8,0,0" IsEnabled="{Binding IsIdle}">
              <Button Content="{lan:I18n Lyrics.Button_Export}" Command="{Binding ExportEditedCommand}" Margin="0,0,8,0" />
              <Button Content="{lan:I18n Lyrics.Button_Realign}" Command="{Binding RealignEditedCommand}" Margin="0,0,12,0" />
              <TextBlock Text="{lan:I18n Lyrics.Label_Offset}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <NumericUpDown Value="{Binding Options.OffsetMs}" Minimum="-60000" Maximum="60000" Increment="10" FormatString="0" Width="116" />
            </WrapPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" TextWrapping="Wrap" MaxHeight="65" Margin="0,10,0,0" FontSize="12" AutomationProperties.AutomationId="LyricsStatus" />
  </Grid>
</UserControl>
