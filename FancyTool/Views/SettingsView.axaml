<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FancyToolAva.ViewModels"
             xmlns:models="using:FancyToolAva.Models"
             xmlns:helpers="using:FancyToolAva.Helpers"
             xmlns:lan="clr-namespace:Lang.Avalonia.MarkupExtensions;assembly=Lang.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="FancyToolAva.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <helpers:IntEqualsToBoolConverter x:Key="IntEq" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Classes="PageRoot">
            <TextBlock Classes="PageTitle" Text="{lan:I18n Settings.Page_Title}" />
            <TextBlock Classes="PageSubtitle" Text="{lan:I18n Settings.Page_Subtitle}" />

            <TextBlock Classes="GroupHeader" Text="{Binding GroupAppearance}" />

            <Border Classes="ToolCard">
                <StackPanel Classes="ToolCardContent">
                    <Grid ColumnDefinitions="200,*,Auto" Margin="0,4">
                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="SemiBold" Text="{Binding LabelTheme}" />
                            <TextBlock Classes="Caption" Text="{Binding CaptionTheme}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <RadioButton Content="{Binding ThemeSystem}"
                                         GroupName="ThemeMode"
                                         IsChecked="{Binding App.Preferences.ThemeIndex, Mode=TwoWay, Converter={StaticResource IntEq}, ConverterParameter=0}" />
                            <RadioButton Content="{Binding ThemeLight}"
                                         GroupName="ThemeMode"
                                         IsChecked="{Binding App.Preferences.ThemeIndex, Mode=TwoWay, Converter={StaticResource IntEq}, ConverterParameter=1}" />
                            <RadioButton Content="{Binding ThemeDark}"
                                         GroupName="ThemeMode"
                                         IsChecked="{Binding App.Preferences.ThemeIndex, Mode=TwoWay, Converter={StaticResource IntEq}, ConverterParameter=2}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="200,*,Auto" Margin="0,8,0,4" IsEnabled="{Binding CanUseBackdrop}">
                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="SemiBold" Text="{Binding LabelBackdrop}" />
                            <TextBlock Classes="Caption" Text="{Binding CaptionBackdrop}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2"
                                  Width="220" VerticalAlignment="Center"
                                  ItemsSource="{Binding BackdropOptions}"
                                  SelectedIndex="{Binding App.Preferences.BackdropIndex, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="200,*,Auto" Margin="0,4" IsEnabled="{Binding CanCustomizeAcrylic}">
                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="SemiBold" Text="{Binding LabelAcrylicTint}" />
                            <TextBlock Classes="Caption" Text="{Binding CaptionAcrylicTint}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2"
                                  Width="220" VerticalAlignment="Center"
                                  ItemsSource="{Binding TintOptions}"
                                  SelectedIndex="{Binding App.Preferences.AcrylicTintIndex, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="200,*,Auto" Margin="0,4" IsEnabled="{Binding CanCustomizeAcrylic}">
                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="SemiBold" Text="{Binding LabelTintOpacity}" />
                        </StackPanel>
                        <Slider Grid.Column="2"
                                Width="220" VerticalAlignment="Center"
                                Minimum="0" Maximum="100"
                                TickFrequency="10"
                                Value="{Binding App.Preferences.AcrylicTintOpacity, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="200,*,Auto" Margin="0,4" IsEnabled="{Binding CanCustomizeAcrylic}">
                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="SemiBold" Text="{Binding LabelMaterialOpacity}" />
                        </StackPanel>
                        <Slider Grid.Column="2"
                                Width="220" VerticalAlignment="Center"
                                Minimum="0" Maximum="100"
                                TickFrequency="10"
                                Value="{Binding App.Preferences.AcrylicMaterialOpacity, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Classes="GroupHeader" Text="{Binding GroupLanguage}" />

            <Border Classes="ToolCard">
                <StackPanel Classes="ToolCardContent">
                    <Grid ColumnDefinitions="200,*,Auto" Margin="0,4">
                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="SemiBold" Text="{Binding LabelLanguage}" />
                            <TextBlock Classes="Caption" Text="{Binding CaptionLanguage}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2"
                                  Width="200" VerticalAlignment="Center"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NativeName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Classes="GroupHeader" Text="{Binding GroupNetwork}" />

            <Border Classes="ToolCard">
                <StackPanel Classes="ToolCardContent">
                    <Grid ColumnDefinitions="200,*,Auto" Margin="0,4">
                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="SemiBold" Text="{Binding LabelConnectionTimeout}" />
                            <TextBlock Classes="Caption" Text="{Binding CaptionConnectionTimeout}" />
                        </StackPanel>
                        <NumericUpDown Grid.Column="2"
                                       Minimum="1" Maximum="30"
                                       Value="{Binding App.Preferences.ConnectionTimeoutSec, Mode=TwoWay}"
                                       Width="120"
                                       VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Classes="GroupHeader" Text="{Binding GroupModels}" />

            <Border Classes="ToolCard">
                <StackPanel Classes="ToolCardContent">
                    <TextBlock FontWeight="SemiBold" Text="{Binding LabelModelsDirectory}" />
                    <TextBlock Classes="Caption" Text="{Binding CaptionModelsDirectory}" TextWrapping="Wrap" />
                    <TextBox IsReadOnly="True" Text="{Binding ModelsDirectory, Mode=OneWay}" TextWrapping="Wrap"
                             AutomationProperties.Name="{Binding LabelModelsDirectory}"
                             AutomationProperties.AutomationId="SettingsModelsDirectory" />
                    <WrapPanel>
                        <Button Content="{Binding ButtonSelectModelsDirectory}" Command="{Binding PickModelsDirectoryCommand}"
                                Margin="0,0,8,4" AutomationProperties.AutomationId="SettingsSelectModelsDirectory" />
                        <Button Content="{Binding ButtonOpenModelsDirectory}" Command="{Binding OpenModelsDirectoryCommand}"
                                Margin="0,0,8,4" AutomationProperties.AutomationId="SettingsOpenModelsDirectory" />
                        <Button Content="{Binding ButtonResetModelsDirectory}" Command="{Binding ResetModelsDirectoryCommand}"
                                Margin="0,0,0,4" AutomationProperties.AutomationId="SettingsResetModelsDirectory" />
                    </WrapPanel>
                    <TextBlock IsVisible="{Binding HasModelStorageError}" Text="{Binding ModelStorageError}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               AutomationProperties.AutomationId="SettingsModelsDirectoryError" />
                </StackPanel>
            </Border>

            <TextBlock Classes="GroupHeader" Text="{Binding GroupImage}" />

            <Border Classes="ToolCard">
                <StackPanel Classes="ToolCardContent">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock FontWeight="SemiBold" Text="{Binding LabelSrTileSize}" />
                            <TextBlock Classes="Caption" Text="{Binding CaptionSrTileSize}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  Width="200" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="SettingsSrTileSize"
                                  ItemsSource="{Binding SrTileOptions}"
                                  SelectedIndex="{Binding SelectedSrTileSizeIndex, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:LocalizedOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Classes="GroupHeader" Text="{Binding GroupAbout}" />

            <Border Classes="ToolCard">
                <StackPanel Classes="ToolCardContent">
                    <TextBlock FontWeight="SemiBold" Text="{Binding AboutTitle}" />
                    <TextBlock Classes="Caption" Text="{Binding AboutDesc}" />
                </StackPanel>
            </Border>

            <Border Classes="ToolCard">
                <StackPanel Classes="ToolCardContent">
                    <Grid ColumnDefinitions="200,*,Auto" Margin="0,4">
                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="SemiBold" Text="{Binding LabelOpenLogs}" />
                            <TextBlock Classes="Caption" Text="{Binding CaptionOpenLogs}" />
                        </StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Center"
                                Command="{Binding OpenLogFolderCommand}"
                                Content="{Binding ButtonOpenLogs}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
