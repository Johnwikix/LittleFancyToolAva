<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FancyToolAva.ViewModels"
             xmlns:controls="using:FancyToolAva.Views.Controls"
             xmlns:helpers="using:FancyToolAva.Helpers"
             xmlns:lan="clr-namespace:Lang.Avalonia.MarkupExtensions;assembly=Lang.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="FancyToolAva.Views.TcpServerView"
             x:DataType="vm:TcpServerViewModel">

    <UserControl.Resources>
        <helpers:InverseBoolConverter x:Key="Inv" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto"
          Margin="{StaticResource PageMargin}">

        <controls:ToolPageHeader Grid.Row="0"
                                 Title="{lan:I18n Tcp.Title}"
                                 Subtitle="{lan:I18n Tcp.Subtitle}">
            <controls:ToolPageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <controls:StatusPill Status="{Binding CurrentSession.ConnectionStatus}"
                                         Text="{Binding CurrentSession.ConnectionStatus, Converter={StaticResource StatusTextConverter}}"
                                         Detail="{Binding CurrentSession.StatusDetail}" />
                </StackPanel>
            </controls:ToolPageHeader.Actions>
        </controls:ToolPageHeader>

        <Grid Grid.Row="1" ColumnDefinitions="320,3*" Margin="0,8,0,0">

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0">
                <StackPanel Spacing="4">
                    <Border Classes="ToolCard">
                        <StackPanel Classes="ToolCardContent" Spacing="4">
                            <TextBlock Classes="SectionHeader" Text="{lan:I18n LinkTest.Label_Function}" />
                            <Grid Classes="FormRow2" ColumnDefinitions="*,12,*">
                                <RadioButton Grid.Column="0"
                                             Content="{lan:I18n LinkTest.Mode_Debug}"
                                             GroupName="TcpFunction"
                                             IsChecked="{Binding FunctionIndex, Mode=TwoWay, Converter={StaticResource IntEq}, ConverterParameter=0}" />
                                <RadioButton Grid.Column="2"
                                             Content="{lan:I18n LinkTest.Mode_LinkTest}"
                                             GroupName="TcpFunction"
                                             IsChecked="{Binding FunctionIndex, Mode=TwoWay, Converter={StaticResource IntEq}, ConverterParameter=1}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="ToolCard"
                            IsVisible="{Binding FunctionIndex, Converter={StaticResource IntEq}, ConverterParameter=0}">
                        <StackPanel Classes="ToolCardContent" Spacing="4">
                            <TextBlock Classes="SectionHeader" Text="{lan:I18n Tcp.Group_ConnectMode}" />
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Tcp.Label_Session}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemTemplate="{StaticResource SessionChoiceItemTemplate}"
                                          SelectionBoxItemTemplate="{StaticResource SessionChoiceBoxTemplate}"
                                          ItemsSource="{Binding Choices}"
                                          SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" />
                            </StackPanel>
                            <!-- 会话的显示名就是模式与端点：运行中冻结，否则下拉与头部胶囊会显示与实际 socket 不一致的端点。 -->
                            <Grid Classes="FormRow2" ColumnDefinitions="*,12,*"
                                  IsEnabled="{Binding CurrentSession.IsActive, Converter={StaticResource Inv}}"
                                  ToolTip.Tip="{lan:I18n Tcp.ToolTip_LockedWhileRunning}">
                                <RadioButton Grid.Column="0"
                                             Content="{lan:I18n Tcp.Mode_Server}"
                                             GroupName="TcpMode"
                                             IsChecked="{Binding CurrentSession.ModeIndex, Mode=TwoWay, Converter={StaticResource IntEq}, ConverterParameter=0}" />
                                <RadioButton Grid.Column="2"
                                             Content="{lan:I18n Tcp.Mode_Client}"
                                             GroupName="TcpMode"
                                             IsChecked="{Binding CurrentSession.ModeIndex, Mode=TwoWay, Converter={StaticResource IntEq}, ConverterParameter=1}" />
                            </Grid>
                            <Grid Classes="FormRow2" ColumnDefinitions="*,12,*"
                                  IsEnabled="{Binding CurrentSession.IsActive, Converter={StaticResource Inv}}"
                                  ToolTip.Tip="{lan:I18n Tcp.ToolTip_LockedWhileRunning}">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Classes="FieldLabel" Text="{lan:I18n Tcp.Label_Address}" />
                                    <TextBox Text="{Binding CurrentSession.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Classes="FieldLabel" Text="{lan:I18n Tcp.Label_Port}" />
                                    <TextBox Text="{Binding CurrentSession.Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Classes="ActionBar">
                                <Button Command="{Binding CurrentSession.StartCommand}" Classes="Primary" Content="{lan:I18n Common.Button_Start}"
                                        IsEnabled="{Binding CurrentSession.IsActive, Converter={StaticResource Inv}}" />
                                <Button Command="{Binding CurrentSession.StopCommand}" Classes="Danger" Content="{lan:I18n Common.Button_Stop}"
                                        IsEnabled="{Binding CurrentSession.IsActive}" />
                                <Button Command="{Binding CloseSessionCommand}"
                                        IsEnabled="{Binding CanCloseSession}"
                                        Content="{lan:I18n Tcp.Button_CloseSession}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="ToolCard"
                            IsVisible="{Binding FunctionIndex, Converter={StaticResource IntEq}, ConverterParameter=1}">
                        <StackPanel Classes="ToolCardContent" Spacing="4">
                            <TextBlock Classes="SectionHeader" Text="{lan:I18n LinkTest.Group_Settings}" />
                            <Grid Classes="FormRow2" ColumnDefinitions="*,12,*">
                                <RadioButton Grid.Column="0"
                                             Content="{lan:I18n LinkTest.Role_Receiver}"
                                             GroupName="TcpLinkRole"
                                             IsChecked="{Binding LinkRoleIndex, Mode=TwoWay, Converter={StaticResource IntEq}, ConverterParameter=0}" />
                                <RadioButton Grid.Column="2"
                                             Content="{lan:I18n LinkTest.Role_Sender}"
                                             GroupName="TcpLinkRole"
                                             IsChecked="{Binding LinkRoleIndex, Mode=TwoWay, Converter={StaticResource IntEq}, ConverterParameter=1}" />
                            </Grid>
                            <TextBlock Classes="Caption"
                                       IsVisible="{Binding LinkRoleIndex, Converter={StaticResource IntEq}, ConverterParameter=0}"
                                       Text="{lan:I18n LinkTest.Hint_ReceiverEndpoint}" />
                            <TextBlock Classes="Caption"
                                       IsVisible="{Binding LinkRoleIndex, Converter={StaticResource IntEq}, ConverterParameter=1}"
                                       Text="{lan:I18n LinkTest.Hint_SenderEndpoint}" />
                            <Grid Classes="FormRow2" ColumnDefinitions="*,12,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Classes="FieldLabel" Text="{lan:I18n Tcp.Label_Address}" />
                                    <TextBox Text="{Binding LinkAddress, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Classes="FieldLabel" Text="{lan:I18n Tcp.Label_Port}" />
                                    <TextBox Text="{Binding LinkPort, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n LinkTest.Label_Duration}" />
                                <NumericUpDown Minimum="1" Maximum="600" Value="{Binding LinkDurationSec, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n LinkTest.Label_ChunkKB}" />
                                <NumericUpDown Minimum="1" Maximum="4096" Value="{Binding LinkChunkKB, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Classes="ActionBar">
                                <Button Command="{Binding StartLinkTestCommand}" Classes="Primary" Content="{lan:I18n LinkTest.Button_Start}"
                                        IsEnabled="{Binding LinkTest.IsRunning, Converter={StaticResource Inv}}" />
                                <Button Command="{Binding StopLinkTestCommand}" Classes="Danger" Content="{lan:I18n Common.Button_Stop}"
                                        IsEnabled="{Binding LinkTest.IsRunning}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="ToolCard"
                            IsVisible="{Binding FunctionIndex, Converter={StaticResource IntEq}, ConverterParameter=0}">
                        <StackPanel Classes="ToolCardContent" Spacing="4">
                            <TextBlock Classes="SectionHeader" Text="{lan:I18n Tcp.Group_Options}" />
                            <CheckBox Content="{lan:I18n Tcp.Option_HexSend}" IsChecked="{Binding CurrentSession.IsHexSend, Mode=TwoWay}" />
                            <CheckBox Content="{lan:I18n Tcp.Option_HexDisplay}" IsChecked="{Binding CurrentSession.IsHexDisplay, Mode=TwoWay}" />
                            <CheckBox Content="{lan:I18n Tcp.Option_EnableFrameBreak}" IsChecked="{Binding CurrentSession.EnableFrameBreak, Mode=TwoWay}" />
                            <StackPanel Classes="FormRow"
                                        IsVisible="{Binding CurrentSession.EnableFrameBreak}">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Tcp.Label_FrameBreak}" />
                                <NumericUpDown Minimum="10" Maximum="500"
                                               Value="{Binding CurrentSession.FrameBreakInterval, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Tcp.Label_PollInterval}" />
                                <NumericUpDown Minimum="1" Value="{Binding CurrentSession.PollInterval, Mode=TwoWay}" />
                            </StackPanel>
                            <CheckBox Content="{lan:I18n Tcp.Option_EnableSendCount}" IsChecked="{Binding CurrentSession.EnableSendCount, Mode=TwoWay}" />
                            <StackPanel Classes="FormRow"
                                        IsVisible="{Binding CurrentSession.EnableSendCount}">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Tcp.Label_SendCount}" />
                                <NumericUpDown Minimum="1" Maximum="999999"
                                               Value="{Binding CurrentSession.SendCount, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Classes="ActionBar">
                                <Button Command="{Binding CurrentSession.StartPollingCommand}"
                                        Content="{lan:I18n Tcp.Button_TimedSend}"
                                        IsEnabled="{Binding CurrentSession.IsPolling, Converter={StaticResource Inv}}" />
                                <Button Command="{Binding CurrentSession.StopPollingCommand}"
                                        Classes="Danger"
                                        Content="{lan:I18n Common.Button_Stop}"
                                        IsEnabled="{Binding CurrentSession.IsPolling}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="ToolCard"
                            MaxHeight="200"
                            IsVisible="{Binding CurrentSession.IsListening}">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <TextBlock Classes="SectionHeader" Text="{lan:I18n Tcp.Group_Clients}" />
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding CurrentSession.ConnectedClients}"
                                     SelectedItem="{Binding CurrentSession.SelectedClient, Mode=TwoWay}"
                                     Margin="0,4,0,0" />
                            <Button Grid.Row="2"
                                    Command="{Binding CurrentSession.KickClientCommand}"
                                    Classes="Danger"
                                    Content="{lan:I18n Tcp.Button_DisconnectClient}"
                                    IsEnabled="{Binding CurrentSession.IsListening}"
                                    Margin="0,4,0,0" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" RowDefinitions="3*,8,2*" Margin="10,0,0,0">

                <Border Grid.Row="0" Classes="ToolCard" Padding="0"
                        IsVisible="{Binding FunctionIndex, Converter={StaticResource IntEq}, ConverterParameter=0}">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,12,16,8">
                            <TextBlock Classes="SectionHeader" Grid.Column="0" Text="{lan:I18n Tcp.Group_Log}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <ToggleButton Classes="Quiet" Content="{lan:I18n Tcp.Button_MergedLog}" IsChecked="{Binding IsMergedLog, Mode=TwoWay}" />
                                <Button Classes="Quiet" Command="{Binding ClearLogCommand}" Content="{lan:I18n Common.Button_Clear}" />
                                <Button Classes="Quiet" Command="{Binding SaveLogCommand}" Content="{lan:I18n Tcp.Button_SaveData}" />
                            </StackPanel>
                        </Grid>
                        <controls:LogBufferView Grid.Row="1" Margin="12,0,12,0"
                                                 IsVisible="{Binding IsMergedLog, Converter={StaticResource Inv}}"
                                                 Entries="{Binding CurrentSession.Log.Entries}" />
                        <controls:LogBufferView Grid.Row="1" Margin="12,0,12,0"
                                                 IsVisible="{Binding IsMergedLog}"
                                                 Entries="{Binding MergedLog.Entries}" />
                        <Border Grid.Row="2" Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                Padding="16,6" Margin="12,0,12,12" CornerRadius="4">
                            <TextBlock Classes="Caption">
                                <Run Text="{lan:I18n Tcp.Label_BufferUsage}" />
                                <Run Text="{Binding BufferUsageCount}" />
                                <Run Text=" / " />
                                <Run Text="{Binding BufferUsageMax}" />
                                <Run Text="{lan:I18n Tcp.Label_BufferLines}" />
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Classes="ToolCard" Padding="0"
                        IsVisible="{Binding FunctionIndex, Converter={StaticResource IntEq}, ConverterParameter=1}">
                    <Grid RowDefinitions="Auto,*" Margin="16,12,16,12">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <TextBlock Classes="SectionHeader" Grid.Column="0" Text="{lan:I18n LinkTest.Group_Stats}" />
                            <TextBlock Classes="Caption" Grid.Column="1" VerticalAlignment="Center"
                                       Text="{Binding LinkTest.StatusText}" />
                        </Grid>
                        <StackPanel Grid.Row="1" Spacing="12" VerticalAlignment="Center">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="Caption" Text="{lan:I18n LinkTest.Label_CurrentSpeed}" />
                                <TextBlock Text="{Binding LinkTest.CurrentSpeedText}"
                                           FontSize="28" FontWeight="SemiBold"
                                           FontFamily="{StaticResource MonoFontFamily}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,12,*,12,*">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Classes="Caption" Text="{lan:I18n LinkTest.Label_AvgSpeed}" />
                                    <TextBlock Text="{Binding LinkTest.AvgSpeedText}" Classes="Caption"
                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MonoFontSize}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Classes="Caption" Text="{lan:I18n LinkTest.Label_TotalData}" />
                                    <TextBlock Text="{Binding LinkTest.TotalDataText}" Classes="Caption"
                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MonoFontSize}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Spacing="2">
                                    <TextBlock Classes="Caption" Text="{lan:I18n LinkTest.Label_Elapsed}" />
                                    <TextBlock Text="{Binding LinkTest.ElapsedText}" Classes="Caption"
                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MonoFontSize}" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding LinkTest.ProgressValue}"
                                         IsVisible="{Binding LinkTest.IsSender}" />
                            <Grid ColumnDefinitions="*,12,*,12,*,12,*"
                                  IsVisible="{Binding LinkTest.HasLossStats}">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Classes="Caption" Text="{lan:I18n LinkTest.Label_PacketsSent}" />
                                    <TextBlock Text="{Binding LinkTest.SentPacketsText}" Classes="Caption"
                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MonoFontSize}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Classes="Caption" Text="{lan:I18n LinkTest.Label_PacketsReceived}" />
                                    <TextBlock Text="{Binding LinkTest.ReceivedPacketsText}" Classes="Caption"
                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MonoFontSize}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Spacing="2">
                                    <TextBlock Classes="Caption" Text="{lan:I18n LinkTest.Label_PacketsLost}" />
                                    <TextBlock Text="{Binding LinkTest.LostPacketsText}" Classes="Caption"
                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MonoFontSize}" />
                                </StackPanel>
                                <StackPanel Grid.Column="6" Spacing="2">
                                    <TextBlock Classes="Caption" Text="{lan:I18n LinkTest.Label_LossRate}" />
                                    <TextBlock Text="{Binding LinkTest.LossRateText}" Classes="Caption"
                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource MonoFontSize}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Classes="ToolCard" Padding="0"
                        IsVisible="{Binding FunctionIndex, Converter={StaticResource IntEq}, ConverterParameter=0}">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0" Classes="SectionHeader" Text="{lan:I18n Tcp.Group_Send}" Margin="16,12,16,8" />
                        <TextBox Grid.Row="1"
                                 Classes="TerminalInput"
                                 Margin="16,0,16,8"
                                 Text="{Binding CurrentSession.SendText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Grid.Row="2" Classes="ActionBar" Margin="16,0,16,12">
                            <Button Command="{Binding SendCommand}" Classes="Primary" Content="{lan:I18n Common.Button_Send}"
                                    IsEnabled="{Binding CanSend}" />
                            <CheckBox Content="{lan:I18n Session.Label_SendAllSessions}"
                                      IsChecked="{Binding SendToAll, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Classes="ToolCard" Padding="0"
                        IsVisible="{Binding FunctionIndex, Converter={StaticResource IntEq}, ConverterParameter=1}">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,12,16,8">
                            <TextBlock Classes="SectionHeader" Grid.Column="0" Text="{lan:I18n LinkTest.Group_Results}" />
                            <Button Grid.Column="1" Classes="Quiet" Command="{Binding LinkTest.ClearResultsCommand}"
                                    Content="{lan:I18n Common.Button_Clear}" />
                        </Grid>
                        <TextBox Grid.Row="1"
                                 Classes="TerminalBoxReadOnly"
                                 Margin="16,0,16,8"
                                 Text="{Binding LinkTest.ResultLog}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <controls:TerminalStatusBar Grid.Row="2"
                                    Margin="0,10,0,0"
                                    RxCount="{Binding CurrentSession.RxCount}"
                                    TxCount="{Binding CurrentSession.TxCount}"
                                    ElapsedText="{Binding CurrentSession.ElapsedText}"
                                    MiddleDetail="{Binding AggregateText}"
                                    RightDetail="{Binding CurrentSession.StatusText}" />
    </Grid>
</UserControl>
