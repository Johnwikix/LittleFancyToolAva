<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FancyToolAva.ViewModels"
             xmlns:helpers="using:FancyToolAva.Helpers"
             xmlns:controls="using:FancyToolAva.Views.Controls"
             xmlns:lan="clr-namespace:Lang.Avalonia.MarkupExtensions;assembly=Lang.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="FancyToolAva.Views.SerialPortView"
             x:DataType="vm:SerialPortViewModel">

    <UserControl.Resources>
        <helpers:InverseBoolConverter x:Key="Inv" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto"
          Margin="{StaticResource PageMargin}">

        <controls:ToolPageHeader Grid.Row="0"
                                 Title="{lan:I18n Serial.Title}"
                                 Subtitle="{lan:I18n Serial.Subtitle}">
            <controls:ToolPageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <controls:StatusPill Status="{Binding ConnectionStatus}"
                                         Text="{Binding ConnectionStatus, Converter={StaticResource StatusTextConverter}}"
                                         Detail="{Binding StatusDetail}" />
                </StackPanel>
            </controls:ToolPageHeader.Actions>
        </controls:ToolPageHeader>

        <Grid Grid.Row="1" ColumnDefinitions="320,3*" Margin="0,8,0,0">

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0">
                <StackPanel Spacing="4">
                    <Border Classes="ToolCard">
                        <StackPanel Classes="ToolCardContent" Spacing="4">
                            <TextBlock Classes="SectionHeader" Text="{lan:I18n Serial.Group_PortSettings}" />
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Serial.Label_Port}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding PortNames}"
                                          SelectedItem="{Binding SelectedPort, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Serial.Label_BaudRate}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding BaudRates}"
                                          SelectedIndex="{Binding BaudRateIndex, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Serial.Label_Parity}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Parities}"
                                          SelectedIndex="{Binding ParityIndex, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Serial.Label_DataBits}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding DataBitsList}"
                                          SelectedIndex="{Binding DataBitsIndex, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Serial.Label_StopBits}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding StopBitsList}"
                                          SelectedIndex="{Binding StopBitsIndex, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Serial.Label_Encoding}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Encodings}"
                                          SelectedIndex="{Binding EncodingIndex, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Classes="ActionBar">
                                <Button Command="{Binding RefreshPortsCommand}" Content="{lan:I18n Serial.Button_RefreshPorts}" />
                                <Button Command="{Binding ConnectCommand}"
                                        Classes="Primary"
                                        Content="{lan:I18n Serial.Button_Connect}"
                                        IsEnabled="{Binding IsConnected, Converter={StaticResource Inv}}" />
                                <Button Command="{Binding DisconnectCommand}"
                                        Classes="Danger"
                                        Content="{lan:I18n Serial.Button_Disconnect}"
                                        IsEnabled="{Binding IsConnected}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="ToolCard">
                        <StackPanel Classes="ToolCardContent" Spacing="4">
                            <TextBlock Classes="SectionHeader" Text="{lan:I18n Serial.Group_Options}" />
                            <CheckBox Content="{lan:I18n Serial.Option_HexSend}" IsChecked="{Binding IsHexSend, Mode=TwoWay}" />
                            <CheckBox Content="{lan:I18n Serial.Option_HexDisplay}" IsChecked="{Binding IsHexDisplay, Mode=TwoWay}" />
                            <CheckBox Content="{lan:I18n Serial.Option_RTS}" IsChecked="{Binding IsRtsEnabled, Mode=TwoWay}"
                                      Command="{Binding ToggleRtsCommand}" />
                            <CheckBox Content="{lan:I18n Serial.Option_DTR}" IsChecked="{Binding IsDtrEnabled, Mode=TwoWay}"
                                      Command="{Binding ToggleDtrCommand}" />
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Serial.Label_FrameBreak}" />
                                <NumericUpDown Minimum="10" Maximum="500"
                                               Value="{Binding FrameBreakInterval, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Serial.Label_PollInterval}" />
                                <NumericUpDown Minimum="1" Value="{Binding PollInterval, Mode=TwoWay}" />
                            </StackPanel>
                            <CheckBox Content="{lan:I18n Serial.Option_EnableSendCount}" IsChecked="{Binding EnableSendCount, Mode=TwoWay}" />
                            <StackPanel Classes="FormRow"
                                        IsVisible="{Binding EnableSendCount}">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Serial.Label_SendCount}" />
                                <NumericUpDown Minimum="1" Maximum="999999"
                                               Value="{Binding SendCount, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Classes="ActionBar">
                                <Button Command="{Binding StartPollingCommand}"
                                        Content="{lan:I18n Serial.Button_TimedSend}"
                                        IsEnabled="{Binding IsPolling, Converter={StaticResource Inv}}" />
                                <Button Command="{Binding StopPollingCommand}"
                                        Classes="Danger"
                                        Content="{lan:I18n Common.Button_Stop}"
                                        IsEnabled="{Binding IsPolling}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" RowDefinitions="3*,8,2*" Margin="10,0,0,0">

                <Border Grid.Row="0" Classes="ToolCard" Padding="0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,12,16,8">
                            <TextBlock Classes="SectionHeader" Grid.Column="0" Text="{lan:I18n Serial.Group_Log}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Classes="Quiet" Command="{Binding ClearCommand}" Content="{lan:I18n Common.Button_Clear}" />
                                <Button Classes="Quiet" Command="{Binding SaveDataCommand}" Content="{lan:I18n Serial.Button_SaveData}" />
                            </StackPanel>
                        </Grid>
                        <controls:LogBufferView Grid.Row="1" Margin="12,0,12,0" Entries="{Binding Log.Entries}" />
                        <Border Grid.Row="2" Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                Padding="16,6" Margin="12,0,12,12" CornerRadius="4">
                            <TextBlock Classes="Caption">
                                <Run Text="{lan:I18n Serial.Label_BufferUsage}" />
                                <Run Text="{Binding Log.Count}" />
                                <Run Text=" / " />
                                <Run Text="{Binding Log.MaxLines}" />
                                <Run Text="{lan:I18n Serial.Label_BufferLines}" />
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Classes="ToolCard" Padding="0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0" Classes="SectionHeader" Text="{lan:I18n Serial.Group_Send}" Margin="16,12,16,8" />
                        <TextBox Grid.Row="1"
                                 Classes="TerminalInput"
                                 Margin="16,0,16,8"
                                 Text="{Binding SendText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Grid.Row="2" Classes="ActionBar" Margin="16,0,16,12">
                            <Button Command="{Binding SendCommand}"
                                    Classes="Primary"
                                    Content="{lan:I18n Common.Button_Send}"
                                    IsEnabled="{Binding IsConnected}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <controls:TerminalStatusBar Grid.Row="2"
                                    Margin="0,10,0,0"
                                    RxCount="{Binding RxCount}"
                                    TxCount="{Binding TxCount}"
                                    ElapsedText="{Binding ElapsedText}"
                                    RightDetail="{Binding StatusText}" />
    </Grid>
</UserControl>
