<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FancyToolAva.ViewModels"
             xmlns:helpers="using:FancyToolAva.Helpers"
             xmlns:controls="using:FancyToolAva.Views.Controls"
             xmlns:lan="clr-namespace:Lang.Avalonia.MarkupExtensions;assembly=Lang.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="FancyToolAva.Views.SerialPortView"
             x:DataType="vm:SerialPortViewModel">

    <UserControl.Resources>
        <helpers:InverseBoolConverter x:Key="Inv" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto"
          Margin="{StaticResource PageMargin}">

        <controls:ToolPageHeader Grid.Row="0"
                                 Title="{lan:I18n Serial.Title}"
                                 Subtitle="{lan:I18n Serial.Subtitle}">
            <controls:ToolPageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <controls:StatusPill Status="{Binding CurrentSession.ConnectionStatus}"
                                         Text="{Binding CurrentSession.ConnectionStatus, Converter={StaticResource StatusTextConverter}}"
                                         Detail="{Binding CurrentSession.StatusDetail}" />
                </StackPanel>
            </controls:ToolPageHeader.Actions>
        </controls:ToolPageHeader>

        <Grid Grid.Row="1" ColumnDefinitions="320,3*" Margin="0,8,0,0">

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0">
                <StackPanel Spacing="4">
                    <Border Classes="ToolCard">
                        <StackPanel Classes="ToolCardContent" Spacing="4">
                            <TextBlock Classes="SectionHeader" Text="{lan:I18n Serial.Group_PortSettings}" />
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Serial.Label_Port}" />
	<ComboBox HorizontalAlignment="Stretch"
			  ItemsSource="{Binding PortChoices}"
			  SelectedItem="{Binding SelectedChoice, Mode=TwoWay}">
		<ComboBox.ItemTemplate>
			<DataTemplate x:DataType="vm:SerialChoiceItem">
				<Grid ColumnDefinitions="Auto,*,Auto,Auto"
					  ColumnSpacing="6"
					  Margin="0,2">
					<Ellipse Grid.Column="0"
							 Width="8" Height="8"
							 VerticalAlignment="Center"
							 IsVisible="{Binding HasSession}"
							 Fill="{Binding State, Converter={StaticResource ConnectionStatusBrush}}" />
					<TextBlock Grid.Column="0"
							   Text="+"
							   VerticalAlignment="Center"
							   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
							   IsVisible="{Binding IsAddPort}" />
					<StackPanel Grid.Column="1" Spacing="1">
						<TextBlock Text="{Binding DisplayName}"
								   FontSize="12"
								   FontWeight="SemiBold"
								   TextTrimming="CharacterEllipsis" />
						<!--<TextBlock Text="{Binding Summary}"
						FontSize="11"
						Foreground="{DynamicResource TextFillColorTertiaryBrush}"
						IsVisible="{Binding HasSession}"
						TextTrimming="CharacterEllipsis" />-->
					</StackPanel>
					<TextBlock Grid.Column="2"
							   Text="{Binding StateText}"
							   FontSize="11"
							   VerticalAlignment="Center"
							   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
							   IsVisible="{Binding HasSession}" />
					<Border Grid.Column="3"
							VerticalAlignment="Center"
							Padding="5,1"
							CornerRadius="8"
							Background="{DynamicResource AccentFillColorSecondaryBrush}"
							IsVisible="{Binding HasUnread}">
						<TextBlock Text="{Binding UnreadText}"
								   FontSize="10"
								   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
					</Border>
				</Grid>
			</DataTemplate>
		</ComboBox.ItemTemplate>
                                    </ComboBox>
                            </StackPanel>
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Serial.Label_BaudRate}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding BaudRates}"
                                          SelectedIndex="{Binding CurrentSession.BaudRateIndex, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Serial.Label_Parity}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Parities}"
                                          SelectedIndex="{Binding CurrentSession.ParityIndex, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Serial.Label_DataBits}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding DataBitsList}"
                                          SelectedIndex="{Binding CurrentSession.DataBitsIndex, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Serial.Label_StopBits}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding StopBitsList}"
                                          SelectedIndex="{Binding CurrentSession.StopBitsIndex, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Serial.Label_Encoding}" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Encodings}"
                                          SelectedIndex="{Binding CurrentSession.EncodingIndex, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Classes="ActionBar">
                                <Button Command="{Binding RefreshPortsCommand}" Content="{lan:I18n Serial.Button_RefreshPorts}" />
                                <Button Command="{Binding CurrentSession.ConnectCommand}"
                                        Classes="Primary"
                                        Content="{lan:I18n Serial.Button_Connect}"
                                        IsEnabled="{Binding CurrentSession.IsConnected, Converter={StaticResource Inv}}" />
                                <Button Command="{Binding CurrentSession.DisconnectCommand}"
                                        Classes="Danger"
                                        Content="{lan:I18n Serial.Button_Disconnect}"
                                        IsEnabled="{Binding CurrentSession.IsConnected}" />
	                            <Button Grid.Column="1"
			                            Classes="Quiet"
			                            Command="{Binding CloseSessionCommand}"
                                        Content="{lan:I18n Serial.Button_CloseSession}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="ToolCard">
                        <StackPanel Classes="ToolCardContent" Spacing="4">
                            <TextBlock Classes="SectionHeader" Text="{lan:I18n Serial.Group_Options}" />
                            <CheckBox Content="{lan:I18n Serial.Option_HexSend}" IsChecked="{Binding CurrentSession.IsHexSend, Mode=TwoWay}" />
                            <CheckBox Content="{lan:I18n Serial.Option_HexDisplay}" IsChecked="{Binding CurrentSession.IsHexDisplay, Mode=TwoWay}" />
                            <CheckBox Content="{lan:I18n Serial.Option_RTS}" IsChecked="{Binding CurrentSession.IsRtsEnabled, Mode=TwoWay}" />
                            <CheckBox Content="{lan:I18n Serial.Option_DTR}" IsChecked="{Binding CurrentSession.IsDtrEnabled, Mode=TwoWay}" />
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Serial.Label_FrameBreak}" />
                                <NumericUpDown Minimum="10" Maximum="500"
                                               Value="{Binding CurrentSession.FrameBreakInterval, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Classes="FormRow">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Serial.Label_PollInterval}" />
                                <NumericUpDown Minimum="1" Value="{Binding CurrentSession.PollInterval, Mode=TwoWay}" />
                            </StackPanel>
                            <CheckBox Content="{lan:I18n Serial.Option_EnableSendCount}" IsChecked="{Binding CurrentSession.EnableSendCount, Mode=TwoWay}" />
                            <StackPanel Classes="FormRow"
                                        IsVisible="{Binding CurrentSession.EnableSendCount}">
                                <TextBlock Classes="FieldLabel" Text="{lan:I18n Serial.Label_SendCount}" />
                                <NumericUpDown Minimum="1" Maximum="999999"
                                               Value="{Binding CurrentSession.SendCount, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Classes="ActionBar">
                                <Button Command="{Binding CurrentSession.StartPollingCommand}"
                                        Content="{lan:I18n Serial.Button_TimedSend}"
                                        IsEnabled="{Binding CurrentSession.IsPolling, Converter={StaticResource Inv}}" />
                                <Button Command="{Binding CurrentSession.StopPollingCommand}"
                                        Classes="Danger"
                                        Content="{lan:I18n Common.Button_Stop}"
                                        IsEnabled="{Binding CurrentSession.IsPolling}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" RowDefinitions="3*,8,2*" Margin="10,0,0,0">

                <Border Grid.Row="0" Classes="ToolCard" Padding="0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,12,16,8">
                            <TextBlock Classes="SectionHeader" Grid.Column="0" Text="{lan:I18n Serial.Group_Log}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Classes="Quiet" Command="{Binding CurrentSession.ClearCommand}" Content="{lan:I18n Common.Button_Clear}" />
                                <Button Classes="Quiet" Command="{Binding CurrentSession.SaveDataCommand}" Content="{lan:I18n Serial.Button_SaveData}" />
                            </StackPanel>
                        </Grid>
                        <controls:LogBufferView Grid.Row="1" Margin="12,0,12,0" Entries="{Binding CurrentSession.Log.Entries}" />
                        <Border Grid.Row="2" Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                Padding="16,6" Margin="12,0,12,12" CornerRadius="4">
                            <TextBlock Classes="Caption">
                                <Run Text="{lan:I18n Serial.Label_BufferUsage}" />
                                <Run Text="{Binding CurrentSession.Log.Count}" />
                                <Run Text=" / " />
                                <Run Text="{Binding CurrentSession.Log.MaxLines}" />
                                <Run Text="{lan:I18n Serial.Label_BufferLines}" />
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Classes="ToolCard" Padding="0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0" Classes="SectionHeader" Text="{lan:I18n Serial.Group_Send}" Margin="16,12,16,8" />
                        <TextBox Grid.Row="1"
                                 Classes="TerminalInput"
                                 Margin="16,0,16,8"
                                 Text="{Binding CurrentSession.SendText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Grid.Row="2" Classes="ActionBar" Margin="16,0,16,12">
                            <Button Command="{Binding SendCommand}"
                                    Classes="Primary"
                                    Content="{lan:I18n Common.Button_Send}"
                                    IsEnabled="{Binding CanSend}" />
                            <CheckBox Content="{lan:I18n Serial.Label_Broadcast}"
                                      IsChecked="{Binding IsBroadcast, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <controls:TerminalStatusBar Grid.Row="2"
                                    Margin="0,10,0,0"
                                    RxCount="{Binding CurrentSession.RxCount}"
                                    TxCount="{Binding CurrentSession.TxCount}"
                                    ElapsedText="{Binding CurrentSession.ElapsedText}"
                                    MiddleDetail="{Binding AggregateText}"
                                    RightDetail="{Binding CurrentSession.StatusText}" />
    </Grid>
</UserControl>