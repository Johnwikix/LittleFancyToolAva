<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FancyToolAva.ViewModels"
             xmlns:controls="using:FancyToolAva.Views.Controls"
             xmlns:models="using:FancyToolAva.Models"
             xmlns:lan="clr-namespace:Lang.Avalonia.MarkupExtensions;assembly=Lang.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="FancyToolAva.Views.FolderCompareView"
             x:DataType="vm:FolderCompareViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Margin="{StaticResource PageMargin}">
        <controls:ToolPageHeader Grid.Row="0" Title="{lan:I18n FolderCompare.Title}" Subtitle="{lan:I18n FolderCompare.Subtitle}" />
        <Grid Grid.Row="1" ColumnDefinitions="*,16,*" Margin="0,16,0,0">
            <Grid Grid.Column="0" RowDefinitions="Auto,16,Auto,16,*">
                <Border Grid.Row="0" Classes="ToolCard">
                    <StackPanel Classes="ToolCardContent">
                        <TextBlock Classes="SectionHeader" Text="{lan:I18n FolderCompare.Group_Folders}" />
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="{lan:I18n FolderCompare.Label_Source}" />
                            <Grid ColumnDefinitions="*,8,Auto">
                                <TextBox Grid.Column="0" Text="{Binding SourceFolder}" IsReadOnly="True" />
                                <Button Grid.Column="2" Command="{Binding SelectSourceFolderCommand}" Content="{lan:I18n Common.Button_Select}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="{lan:I18n FolderCompare.Label_Target}" />
                            <Grid ColumnDefinitions="*,8,Auto">
                                <TextBox Grid.Column="0" Text="{Binding TargetFolder}" IsReadOnly="True" />
                                <Button Grid.Column="2" Command="{Binding SelectTargetFolderCommand}" Content="{lan:I18n Common.Button_Select}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox Content="{lan:I18n FolderCompare.Option_Hash}" IsChecked="{Binding UseHashComparison}" />
                            <CheckBox Content="{lan:I18n FolderCompare.Option_MusicTitle}" IsChecked="{Binding UseMusicTitleComparison}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Classes="ToolCard" IsVisible="{Binding IsComparing}">
                    <StackPanel Classes="ToolCardContent">
                        <TextBlock Classes="SectionHeader" Text="{lan:I18n FolderCompare.Group_Progress}" />
                        <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="1" Height="8" />
                        <TextBlock Text="{Binding StatusText}" Classes="Caption" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="4" Classes="ToolCard" Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,12,16,8">
                            <TextBlock Classes="SectionHeader" Grid.Column="0" Text="{lan:I18n FolderCompare.Group_Status}" />
                            <TextBlock Classes="Caption" Grid.Column="1" Text="{Binding StatusText}" />
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="16,0,16,12" Spacing="12">
                            <TextBlock Classes="Caption" Text="{lan:I18n FolderCompare.Label_Tip}" />
                            <TextBlock TextWrapping="Wrap" Text="{lan:I18n FolderCompare.Tip_Content}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Column="2" Classes="ToolCard" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="SectionHeader" Text="{lan:I18n FolderCompare.Group_Result}" Margin="16,12,16,4" />
                    <ListBox Grid.Row="1" Margin="8,0,8,8"
                             ItemsSource="{Binding CompareResults}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:FolderCompareResult">
                                <Border Classes="ToolCardTight" Margin="2,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RelativePath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding State}" Classes="Caption" />
                                        <TextBlock Text="{Binding SourceDetail}" Classes="Caption" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TargetDetail}" Classes="Caption" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Classes="ActionBar">
            <Button Command="{Binding CompareCommand}" Classes="Primary" Content="{lan:I18n FolderCompare.Button_Start}" />
        </StackPanel>
    </Grid>
</UserControl>
