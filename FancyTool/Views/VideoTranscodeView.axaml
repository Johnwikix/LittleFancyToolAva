<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FancyToolAva.ViewModels"
             xmlns:models="using:FancyToolAva.Models"
             xmlns:controls="using:FancyToolAva.Views.Controls"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:lan="clr-namespace:Lang.Avalonia.MarkupExtensions;assembly=Lang.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="FancyToolAva.Views.VideoTranscodeView"
             x:DataType="vm:VideoTranscodeViewModel">
    <UserControl.Styles>
        <Style Selector="TabControl#ParamTabs TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,8" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto" Margin="{StaticResource PageMargin}">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <controls:ToolPageHeader Title="{lan:I18n VideoTranscode.Title}" Subtitle="{lan:I18n VideoTranscode.Subtitle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Command="{Binding AddFilesCommand}" Content="{lan:I18n FileEnc.Button_AddFiles}" />
                <Button Command="{Binding AddFolderCommand}" Content="{lan:I18n FileEnc.Button_AddFolder}" />
                <Button Command="{Binding ClearListCommand}" Content="{lan:I18n FileEnc.Button_Clear}" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" x:Name="BodyScroll" Margin="0,16,0,0" SizeChanged="OnBodySizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="BodyGrid" ColumnDefinitions="360,16,*" Height="560">
            <ScrollViewer x:Name="SettingsPanel" Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <Border Classes="ToolCard">
                    <StackPanel Classes="ToolCardContent" Spacing="14">
                        <TextBlock Classes="SectionHeader" Text="{lan:I18n VideoTranscode.Label_Settings}" />

                        <!-- FFmpeg 内置状态（进程内 shared 库，随应用分发） -->
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10" IsVisible="{Binding ShowFfmpegMissing}">
                            <TextBlock Text="{Binding FfmpegStatusText}" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
                        </Border>

                        <!-- Output Preset -->
                        <StackPanel Classes="FormRow">
                            <TextBlock Classes="FieldLabel" Text="{lan:I18n VideoTranscode.Label_Preset}" />
                            <ComboBox IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" ItemsSource="{Binding HandbrakePresetLabels}" SelectedItem="{Binding SelectedHandbrakePreset, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Compact parameter tabs keep space available for the preview. -->
                        <TabControl x:Name="ParamTabs" Margin="0,4,0,0" IsEnabled="{Binding !IsBusy}">
                            <!-- 1: 封装 / 编码（常驻，GIF 下仍可切回） -->
                            <TabItem Header="{lan:I18n VideoTranscode.Label_Container}">
                                <StackPanel Spacing="10" Margin="0,10,0,0">
                                    <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,8,Auto">
                                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4">
                                            <TextBlock Classes="FieldLabel" Text="{lan:I18n VideoTranscode.Label_Container}" FontSize="12" Opacity="0.8" />
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AvailableContainers}" SelectedItem="{Binding SelectedContainer, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Grid.Row="0" Spacing="4">
                                            <TextBlock Classes="FieldLabel" Text="{lan:I18n VideoTranscode.Label_VideoCodec}" FontSize="12" Opacity="0.8" />
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding FilteredVideoCodecs}" SelectedItem="{Binding SelectedVideoCodec, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="0" Grid.Row="2" Spacing="4">
                                            <TextBlock Classes="FieldLabel" Text="{lan:I18n VideoTranscode.Label_PresetLevel}" FontSize="12" Opacity="0.8" />
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding PresetLabels}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </TabItem>

                            <!-- 2: 音频（常驻，GIF 时禁用） -->
                            <TabItem Header="{lan:I18n VideoTranscode.Tab_Audio}" IsEnabled="{Binding !IsGifMode}">
                                <StackPanel Spacing="10" Margin="0,10,0,0" IsEnabled="{Binding !IsGifMode}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="FieldLabel" Text="{lan:I18n VideoTranscode.Label_AudioCodec}" FontSize="12" Opacity="0.8" />
                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding FilteredAudioCodecs}" SelectedItem="{Binding SelectedAudioCodec, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="FieldLabel" Text="{lan:I18n VideoTranscode.Label_AudioBitrate}" FontSize="12" Opacity="0.8" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Slider Grid.Column="0" Minimum="32" Maximum="512" Value="{Binding AudioBitrateKbps}" />
                                            <TextBlock Grid.Column="1" Text="{Binding AudioBitrateKbps, StringFormat='{}{0}k'}" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="45" TextAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="FieldLabel" Text="{lan:I18n VideoTranscode.Label_AudioGain}" FontSize="12" Opacity="0.8" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Slider Grid.Column="0" Minimum="-30" Maximum="30" Value="{Binding AudioGainDb}" />
                                            <TextBlock Grid.Column="1" Text="{Binding AudioGainDb, StringFormat='{}{0:0.0} dB'}" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="55" TextAlignment="Right" FontSize="11" Opacity="0.8" />
                                        </Grid>
                                        <TextBlock Text="{lan:I18n VideoTranscode.Hint_AudioGain}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </TabItem>

                            <!-- 3: 硬件 / 画质 -->
                            <TabItem Header="{lan:I18n VideoTranscode.Group_Quality}" IsVisible="{Binding !IsGifMode}">
                                <StackPanel Spacing="12" Margin="0,10,0,0">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{lan:I18n VideoTranscode.Label_Hardware}" FontWeight="Bold" FontSize="13" />
                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding HardwareBackendLabels}" SelectedItem="{Binding SelectedHardwareBackend, Mode=TwoWay}" />
                                        <TextBlock Text="{lan:I18n VideoTranscode.Hint_Hardware}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                        <TextBlock Text="{lan:I18n VideoTranscode.Hint_HardwareVaapi}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" IsVisible="{Binding IsVaapiBackend}" />
                                    </StackPanel>
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{lan:I18n VideoTranscode.Group_Quality}" FontWeight="Bold" FontSize="13" />
                                        <StackPanel Spacing="6">
                                            <TextBlock Classes="FieldLabel" Text="{lan:I18n VideoTranscode.Label_RateControl}" FontSize="12" Opacity="0.8" />
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding RateControlLabels}" SelectedItem="{Binding SelectedRateControl, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding IsCrfMode}" Spacing="4">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Grid.Column="0" Text="CRF" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                                                <Slider Grid.Column="1" Minimum="0" Maximum="51" Value="{Binding CrfValue}" />
                                                <TextBlock Grid.Column="2" Text="{Binding CrfValue}" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="24" TextAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{lan:I18n VideoTranscode.Hint_Crf}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding IsBitrateMode}" Spacing="8">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Grid.Column="0" Text="kbps" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                                                <Slider Grid.Column="1" Minimum="100" Maximum="100000" Value="{Binding VideoBitrateKbps}" />
                                                <TextBlock Grid.Column="2" Text="{Binding VideoBitrateKbps, StringFormat='{}{0}k'}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                            <CheckBox IsChecked="{Binding IsTwoPassEnabled}" Content="{lan:I18n VideoTranscode.Option_TwoPass}" IsVisible="{Binding ShowTwoPass}" ToolTip.Tip="{lan:I18n VideoTranscode.Caption_TwoPass}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{lan:I18n VideoTranscode.Label_HdrOutput}" FontWeight="SemiBold" />
                                        <ComboBox ItemsSource="{Binding HdrOutputOptions}" SelectedIndex="{Binding HdrOutputIndex, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" AutomationProperties.AutomationId="VideoHdrOutput">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:LocalizedOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Classes="Caption" Text="{lan:I18n VideoTranscode.Hdr_Hint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="8" AutomationProperties.AutomationId="VideoSuperResolutionOptions">
                                        <CheckBox IsChecked="{Binding IsVideoSrEnabled, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" Content="{lan:I18n VideoTranscode.Sr_Enable}" />
                                        <StackPanel IsVisible="{Binding IsVideoSrEnabled}" Spacing="8">
                                            <StackPanel IsEnabled="{Binding !IsBusy}" Spacing="8">
                                                <ComboBox ItemsSource="{Binding VideoSrModelLabels}" SelectedIndex="{Binding VideoSrModelIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="VideoSrModel">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:LocalizedOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Grid ColumnDefinitions="*,8,*">
                                                    <ComboBox ItemsSource="{Binding VideoSrScaleLabels}" SelectedIndex="{Binding VideoSrScaleIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="VideoSrScale" />
                                                    <ComboBox Grid.Column="2" ItemsSource="{Binding VideoSrBackendLabels}" SelectedIndex="{Binding VideoSrBackendIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="VideoSrBackend">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:LocalizedOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>
                                                <CheckBox IsChecked="{Binding VideoSrAllowCpuFallback, Mode=TwoWay}">
                                                    <TextBlock Text="{lan:I18n VideoTranscode.Sr_AllowCpu}" TextWrapping="Wrap" />
                                                </CheckBox>
                                            </StackPanel>
                                            <TextBlock Text="{lan:I18n VideoTranscode.Sr_Hint}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                                            <Button Command="{Binding InstallVideoSrModelCommand}" Content="{Binding SrInstallLabel}" HorizontalAlignment="Stretch" />
                                            <Button Command="{Binding InstallVideoSrAccelerationCommand}" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{lan:I18n VideoTranscode.Sr_InstallHardware}" TextWrapping="Wrap" />
                                            </Button>
                                            <ProgressBar IsVisible="{Binding IsSrInstalling}" IsIndeterminate="{Binding IsSrHardwareInstalling}" Value="{Binding SrDownloadProgress}" Minimum="0" Maximum="1" Height="5" />
                                            <Button IsVisible="{Binding IsSrInstalling}" Command="{Binding CancelSrInstallationCommand}" Content="{lan:I18n VideoTranscode.Sr_CancelInstall}" />
                                            <TextBlock Text="{Binding SrDownloadText}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding VideoSrDeviceText}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </TabItem>

                            <!-- 4: 滤镜（常驻，视频/GIF 共用） -->
                            <TabItem Header="{lan:I18n VideoTranscode.Group_Filters}">
                                <StackPanel Spacing="10" Margin="0,10,0,0">
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="{lan:I18n VideoTranscode.Label_Scale}" VerticalAlignment="Center" ToolTip.Tip="{lan:I18n VideoTranscode.Hint_ScaleNone}" />
                                        <ComboBox Grid.Column="2" Width="150" ItemsSource="{Binding ScaleModeLabels}" SelectedItem="{Binding SelectedScaleMode, Mode=TwoWay}" ToolTip.Tip="{lan:I18n VideoTranscode.Hint_ScaleNone}" />
                                    </Grid>
                                    <StackPanel IsVisible="{Binding IsScaleActive}" Spacing="6">
                                        <Grid ColumnDefinitions="*,8,*">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="W" FontSize="11" Opacity="0.7" />
                                                <NumericUpDown Minimum="16" Maximum="8192" Value="{Binding ScaleWidth}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock Text="H" FontSize="11" Opacity="0.7" />
                                                <NumericUpDown Minimum="16" Maximum="8192" Value="{Binding ScaleHeight}" />
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox IsChecked="{Binding KeepAspect}" Content="{lan:I18n VideoTranscode.Option_KeepAspect}" />
                                    </StackPanel>

                                    <CheckBox IsChecked="{Binding CropEnabled}" Content="{lan:I18n VideoTranscode.Option_Crop}" />
                                    <StackPanel IsVisible="{Binding CropEnabled}" Spacing="6">
                                        <Grid ColumnDefinitions="*,8,*">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Top" FontSize="11" Opacity="0.7" />
                                                <NumericUpDown Minimum="0" Maximum="1000" Value="{Binding CropTop}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock Text="Bottom" FontSize="11" Opacity="0.7" />
                                                <NumericUpDown Minimum="0" Maximum="1000" Value="{Binding CropBottom}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,8,*">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Left" FontSize="11" Opacity="0.7" />
                                                <NumericUpDown Minimum="0" Maximum="1000" Value="{Binding CropLeft}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock Text="Right" FontSize="11" Opacity="0.7" />
                                                <NumericUpDown Minimum="0" Maximum="1000" Value="{Binding CropRight}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="{lan:I18n VideoTranscode.Label_Fps}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="2" Width="150" ItemsSource="{Binding FpsModeLabels}" SelectedItem="{Binding SelectedFpsMode, Mode=TwoWay}" />
                                    </Grid>
                                    <StackPanel IsVisible="{Binding IsFpsActive}">
                                        <NumericUpDown Minimum="1" Maximum="120" Value="{Binding FpsValue}" Increment="1" />
                                    </StackPanel>

                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="{lan:I18n VideoTranscode.Label_Deinterlace}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="2" Width="150" ItemsSource="{Binding DeinterlaceLabels}" SelectedItem="{Binding SelectedDeinterlace, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="{lan:I18n VideoTranscode.Label_Denoise}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="2" Width="150" ItemsSource="{Binding DenoiseLabels}" SelectedItem="{Binding SelectedDenoise, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </TabItem>

                            <!-- 5: GIF（仅 GIF 模式可见） -->
                            <TabItem Header="{lan:I18n VideoTranscode.Group_GifOptions}" IsVisible="{Binding IsGifMode}">
                                <StackPanel Spacing="8" Margin="0,10,0,0">
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="{lan:I18n VideoTranscode.Label_GifWidth}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="64" Maximum="800" Value="{Binding GifWidth}" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding GifWidth, StringFormat='{}{0}px'}" VerticalAlignment="Center" MinWidth="45" TextAlignment="Right" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="{lan:I18n VideoTranscode.Label_GifFps}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="1" Maximum="30" Value="{Binding GifFps}" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding GifFps, StringFormat='{}{0}fps'}" VerticalAlignment="Center" MinWidth="45" TextAlignment="Right" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="{lan:I18n VideoTranscode.Label_GifColors}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="2" Width="120" ItemsSource="{Binding AvailableGifMaxColors}" SelectedItem="{Binding GifMaxColors, Mode=TwoWay}" />
                                    </Grid>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{lan:I18n VideoTranscode.Label_GifDither}" />
                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding GifDitherLabels}" SelectedItem="{Binding SelectedGifDither, Mode=TwoWay}" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="{lan:I18n VideoTranscode.Label_GifLoop}" VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding GifLoop}" Width="100" />
                                    </Grid>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{lan:I18n VideoTranscode.Label_GifStats}" />
                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding GifStatsLabels}" SelectedItem="{Binding SelectedGifStats, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </TabItem>
                        </TabControl>

                    </StackPanel>
                </Border>
            </ScrollViewer>

            <Grid x:Name="EditorPanel" Grid.Column="2" RowDefinitions="2*,12,*">
                <Border Grid.Row="0" Classes="ToolCard" Padding="14">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Text="{Binding PreviewFileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding PreviewModeText}" FontSize="11" Opacity="0.7" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <Border Grid.Row="1" Background="#11151B" CornerRadius="6" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="PreviewImage" Source="{Binding PreviewBitmap}" Stretch="Uniform" />
                                <TextBlock Text="{Binding PreviewStatusText}" IsVisible="{Binding !HasPreview}" Foreground="#BCC4D0" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" />
                                <Border Background="#B0000000" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8">
                                    <TextBlock Text="{Binding PreviewPositionText}" Foreground="White" FontFamily="monospace" FontSize="11" />
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="{lan:I18n VideoTranscode.Label_Trim}" FontWeight="SemiBold" FontSize="12" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{lan:I18n VideoTranscode.Label_KeepDuration}" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{Binding TrimDurationText}" FontSize="11" />
                                </StackPanel>
                            </Grid>
                            <fa:FARangeSlider Minimum="0" Maximum="{Binding TimelineMaximum}" MinimumRange="{Binding MinimumTrimRange}" StepFrequency="0.01" RangeStart="{Binding TrimStartSeconds, Mode=TwoWay}" RangeEnd="{Binding TrimEndSeconds, Mode=TwoWay}" IsEnabled="{Binding CanEditTrim}" ShowValueToolTip="True" ToolTipStringFormat="{}{0:0.00} s" />
                            <Grid ColumnDefinitions="*,12,*">
                                <StackPanel Spacing="3" IsEnabled="{Binding CanEditTrim}">
                                    <Button Command="{Binding PreviewStartCommand}" Content="{lan:I18n VideoTranscode.Label_TrimStart}" HorizontalAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0" FontSize="11" />
                                    <NumericUpDown Minimum="0" Maximum="{Binding TrimEndSeconds}" Value="{Binding TrimStartSeconds, Mode=TwoWay}" Increment="0.01" FormatString="0.000" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="3" IsEnabled="{Binding CanEditTrim}">
                                    <Button Command="{Binding PreviewEndCommand}" Content="{lan:I18n VideoTranscode.Label_TrimEnd}" HorizontalAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0" FontSize="11" />
                                    <NumericUpDown Minimum="{Binding TrimStartSeconds}" Maximum="{Binding TimelineMaximum}" Value="{Binding TrimEndSeconds, Mode=TwoWay}" Increment="0.01" FormatString="0.000" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{lan:I18n VideoTranscode.Hint_Trim}" FontSize="10" Opacity="0.65" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Grid.Column="1" Command="{Binding ResetTrimCommand}" Content="{lan:I18n VideoTranscode.Button_ResetTrim}" Padding="8,3" FontSize="11" />
                            </Grid>
                            <ProgressBar IsVisible="{Binding IsProgressPreview}" Value="{Binding PreviewConversionProgress}" Minimum="0" Maximum="1" Height="4" />
                        </StackPanel>
                    </Grid>
                </Border>
            <Border Grid.Row="2" Classes="ToolCard" Padding="0"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragEnter="OnDragEnter"
                    DragDrop.DragOver="OnDragOver"
                    DragDrop.Drop="OnDrop">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,8,12,4">
                        <TextBlock Grid.Column="0" Classes="SectionHeader" Text="{Binding StatusText, FallbackValue='File List'}" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="12,0,12,4" HorizontalAlignment="Right">
                        <CheckBox IsChecked="{Binding IncludeAllInFolderScan, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Content="{lan:I18n VideoTranscode.CheckBox_IncludeAllInFolder}" />
                    </StackPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding FileItems}" SelectedItem="{Binding SelectedFileItem, Mode=TwoWay}" BorderThickness="0" Margin="8,0,8,8">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:VideoFileItem">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="4,2">
                                    <SelectableTextBlock Grid.Column="0" Text="VID" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="10" Opacity="0.6" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <SelectableTextBlock Text="{Binding FileName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <SelectableTextBlock Text="{Binding ProbeDisplay}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="8,0">
                                        <SelectableTextBlock Text="{Binding StatusDisplay}" FontSize="11" />
                                        <SelectableTextBlock Text="{Binding ProgressDisplay}" FontSize="11" Opacity="0.8" />
                                    </StackPanel>
                                    <Button Grid.Column="3" Command="{Binding RemoveCommand}" IsEnabled="{Binding !$parent[UserControl].((vm:VideoTranscodeViewModel)DataContext).IsBusy}" Padding="6,2" Background="Transparent" BorderThickness="0" ToolTip.Tip="{lan:I18n FileEnc.Tooltip_Remove}" Content="🗑️" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            </Grid>
        </Grid>
        </ScrollViewer>
        <Border Grid.Row="2" Classes="ToolCard" Padding="12" Margin="0,12,0,0">
            <Grid x:Name="FooterGrid" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,12,Auto">
                <Grid ColumnDefinitions="Auto,8,*,8,Auto,8,Auto">
                    <TextBlock Text="{lan:I18n VideoTranscode.Label_OutputDir}" VerticalAlignment="Center" FontSize="12" />
                    <TextBox Grid.Column="2" IsEnabled="{Binding !IsBusy}" Text="{Binding OutputFolder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" PlaceholderText="{lan:I18n VideoTranscode.Placeholder_OutputDir}" ToolTip.Tip="{lan:I18n VideoTranscode.Hint_OutputDirEmpty}" />
                    <Button Grid.Column="4" Command="{Binding PickOutputFolderCommand}" Content="{lan:I18n Common.Button_Select}" />
                    <Button Grid.Column="6" Command="{Binding OpenOutputFolderCommand}" Content="{lan:I18n FileEnc.Button_Open}" />
                </Grid>
                <StackPanel x:Name="ActionPanel" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Command="{Binding StartTranscodeCommand}" Classes="Primary" Content="{lan:I18n VideoTranscode.Button_Start}" />
                    <Button Command="{Binding TogglePauseCommand}" IsVisible="{Binding IsBusy}" Content="{Binding PauseResumeLabel}" />
                    <Button Command="{Binding StopTranscodeCommand}" IsVisible="{Binding IsBusy}" Content="{lan:I18n Common.Button_Stop}" />
                </StackPanel>
                <Grid x:Name="FooterProgress" Grid.Row="1" Grid.ColumnSpan="3" RowDefinitions="Auto,Auto" ColumnDefinitions="*,12,Auto" IsVisible="{Binding IsBusy}" Margin="0,8,0,0">
                    <ProgressBar Value="{Binding ConversionProgress}" Minimum="0" Maximum="1" Height="5" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding BatchProgressText}" FontSize="11" Opacity="0.8" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" IsVisible="{Binding IsVideoSrEnabled}" Text="{Binding VideoSrDeviceText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
