<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="PublishWithSatoriGC" Version="10.0.13-satori.38707290103.1" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Satori SDK 按 "$(RuntimeIdentifier);$(RuntimeIdentifiers)" 组合每个 RID 的包引用，
         且其 KeepDuplicates 对展开的项列表不生效：只要 RuntimeIdentifier 同时出现在
         RuntimeIdentifiers 中，同一个 PackageReference 就会被引用两次（NU1504）。
         这里只保留单个 RuntimeIdentifier（按平台给默认值），避免 RID 集合重叠。 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('windows'))">win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\storeIcon.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);NU1701;CS8767;CS8625;CS8602;CS8600;CS8604;CS0618</NoWarn>
    <PublishAot>true</PublishAot>
    <VersionPrefix>1.1.0.0</VersionPrefix>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Import Project="WindowsInference.props" />
  <!-- DesktopBridge's ordinary output groups need a managed apphost during IDE
       Build as well as Publish; the native AOT executable exists only at Publish. -->
  <PropertyGroup Condition="'$(FancyToolMsixBuild)' == 'true'">
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <UseAppHost>true</UseAppHost>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FfmpegSmokeTest" />
    <None Include="Libraries/VideoSr/*.onnx;Libraries/VideoSr/models.json;Libraries/VideoSr/NOTICE.md;Libraries/VideoSr/Licenses/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Libraries/InterpolationModels/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Licenses/RIFE.txt" />
    <None Include="Libraries/InterpolationModels/NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Licenses/RIFE-NOTICE.md" />
  </ItemGroup>

  <!-- Satori 运行时包（自包含托管发布用）：SDK 只在 PublishAot != true 时引用
       PublishWithSatoriGC.Runtime.$(RuntimeIdentifier)，一旦某次还原是在 PublishAot=true
       下完成的（MSIX 打包时 DesktopBridge 会自行还原入口工程，并不带 FancyToolMsixBuild），
       还原结果里就只有 AotSdk 包；随后的托管发布阶段按 Runtime 包去找运行时，
       就会报 "Restore the Satori Runtime pack with the same RID used for publish."。
       这里在 PublishAot=true 时显式补上 Runtime 包：包引用写在工程文件里，
       任何一次还原（无论由谁、用什么属性触发）都会带上与 RID 一致的 Satori 运行时，
       托管发布因此总能取到它。PublishAot=false 时由 SDK 自己引用，不重复声明。 -->
  <ItemGroup Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != '' and '$(SatoriPackageVersion)' != ''">
    <PackageReference Include="PublishWithSatoriGC.Runtime.$(RuntimeIdentifier)" Version="[$(SatoriPackageVersion)]" PrivateAssets="all" IncludeAssets="build" />
  </ItemGroup>

  <!-- FFmpeg GPL shared（兼容 9.0 绑定 ABI） 库（进程内经 FFmpeg.AutoGen 调用，随应用分发，用户无需下载）：
       仅 avformat/avcodec/avutil/avfilter/swscale/swresample 六库，来源与 SHA-256 见 Libraries\FFmpeg\BUILD_INFO.md -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('windows')))">
    <None Include="Libraries\FFmpeg\win-x64\*.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <None Include="Libraries\FFmpeg\linux-x64\*.so.*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="%(Filename)%(Extension)" LinuxFileMode="755" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Libraries\FFmpeg\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Licenses\FFmpeg.txt" />
  </ItemGroup>

  <!-- 仓库不收录 FFmpeg shared 六库（单文件超过 GitHub 的 100 MB 限制）：缺失时明确
       报错，避免产出装不上解码库的应用。获取方式见 Libraries\FFmpeg\BUILD_INFO.md。 -->
  <Target Name="EnsureFFmpegSharedLibraries" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="('$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('windows')))) and !Exists('$(MSBuildProjectDirectory)\Libraries\FFmpeg\win-x64\avcodec-63.dll')"
           Code="FT1001"
           Text="缺少 FFmpeg shared 库 Libraries\FFmpeg\win-x64\avcodec-63.dll。仓库不收录这些二进制，请先运行：pwsh -File FancyTool/Libraries/FFmpeg/fetch-ffmpeg.ps1 -Platform win（来源与 SHA-256 见 Libraries/FFmpeg/BUILD_INFO.md）" />
    <Error Condition="'$(RuntimeIdentifier)' == 'linux-x64' and !Exists('$(MSBuildProjectDirectory)\Libraries\FFmpeg\linux-x64\libavcodec.so.63')"
           Code="FT1001"
           Text="缺少 FFmpeg shared 库 Libraries\FFmpeg\linux-x64\libavcodec.so.63。仓库不收录这些二进制，请先运行：pwsh -File FancyTool/Libraries/FFmpeg/fetch-ffmpeg.ps1 -Platform linux（来源与 SHA-256 见 Libraries/FFmpeg/BUILD_INFO.md）" />
  </Target>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <None Include="$(NuGetPackageRoot)/microsoft.windows.ai.machinelearning/2.4.89/license.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Licenses/WindowsML.txt" />
    <None Include="$(NuGetPackageRoot)/microsoft.windows.ai.machinelearning/2.4.89/ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Licenses/WindowsML-ThirdPartyNotices.txt" />
  </ItemGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PackagePrefix>fancy-tool</PackagePrefix>
    <PackageVersion>1.0.0</PackageVersion>
    <PackageMaintainer>FancyTool &lt;noreply@example.com&gt;</PackageMaintainer>
    <PackageDescription>A desktop utility toolbox built on Avalonia</PackageDescription>
    <DebSection>utils</DebSection>
    <DebPriority>optional</DebPriority>
    <DebPackageArchitecture Condition="'$(RuntimeIdentifier)' == 'linux-x64'">amd64</DebPackageArchitecture>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO.Ports" />
  </ItemGroup>

  <!-- _tools 下的独立烟测工程不参与主程序编译 -->
  <ItemGroup>
    <Compile Remove="_tools\**" />
    <None Remove="_tools\**" />
    <Compile Remove="External\**" />
    <EmbeddedResource Remove="External\**" />
    <None Remove="External\**" />
    <ProjectReference Include="External\Lyricify.Lyrics.Helper\Lyricify.Lyrics.Helper.csproj" />
    <None Include="External\Lyricify.Lyrics.Helper\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Licenses\Lyricify-Lyrics-Helper.txt" />
    <None Include="External\NOTICE-Lyrics.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Licenses\Lyrics-NOTICE.txt" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Resources\**" />
    <EmbeddedResource Include="Resources\LyricsModels\*.json" />
    <EmbeddedResource Include="Libraries/VideoCuda/*.ptx" LogicalName="FancyToolAva.VideoCuda.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Libraries/VideoPixels/*.pb" LogicalName="FancyToolAva.VideoPixels.%(Filename)%(Extension)" />
    <EmbeddedResource Include="AudioEnhancement/Coefficients/Assets/dsp-tables.bin" LogicalName="FancyToolAva.AudioEnhancement.Coefficients.dsp-tables.bin" />
  </ItemGroup>

  <ItemGroup>
    <None Update="i18n\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <AdditionalFiles Update="i18n\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.0.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Lang.Avalonia" Version="12.1.1.2" />
    <PackageReference Include="Lang.Avalonia.Analysis" Version="12.1.1.2" PrivateAssets="all" />
    <PackageReference Include="Lang.Avalonia.Json" Version="12.1.1.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.11" />
    <PackageReference Include="z440.atl.core" Version="7.16.0" />
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.4.89" Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.1" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="System.Numerics.Tensors" Version="9.0.0" />
  </ItemGroup>

  <!--
    Windows ML supplies both the managed ONNX API and its matching native runtime.
    Do not install another ONNX Runtime package in the Windows build: conflicting
    onnxruntime.dll copies can silently remove hardware execution providers.
  -->
  <PropertyGroup>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Packaging.Targets" Version="0.1.232" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <DebDependency Include="libc6 (&gt;= 2.30)" />
    <DebDependency Include="libx11-6" />
    <DebDependency Include="libxcb1" />
    <DebDependency Include="libx11-xcb1" />
    <DebDependency Include="libxcursor1" />
    <DebDependency Include="libxrandr2" />
    <DebDependency Include="libxi6" />
    <DebDependency Include="libxext6" />
    <DebDependency Include="libxtst6" />
    <DebDependency Include="libgl1" />
    <DebDependency Include="libfontconfig1" />
    <Content Include="packaging/fancy-tool.desktop" CopyToPublishDirectory="PreserveNewest" LinuxFileMode="644">
      <LinuxPath>/usr/share/applications/fancy-tool.desktop</LinuxPath>
    </Content>
    <Content Include="Assets/storeIcon.png" CopyToPublishDirectory="PreserveNewest" LinuxFileMode="644">
      <LinuxPath>/usr/share/icons/hicolor/128x128/apps/fancy-tool.png</LinuxPath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="i18n\en-US.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <!-- Metadata query only: this target does not compile or publish anything.
       DesktopBridge's AddProjectMetadata ignores reference-only isolation properties. -->
  <Target Name="GetFancyToolMsixMetadata" Returns="@(_FancyToolMsixMetadata)">
    <ItemGroup>
      <_FancyToolMsixMetadata Include="$(MSBuildProjectFullPath)">
        <AppOutputPath>$(OutputPath)</AppOutputPath>
        <AppTargetDir>$(TargetDir)</AppTargetDir>
        <AppExtensionsPath>$(MSBuildProjectExtensionsPath)</AppExtensionsPath>
        <AppPublishDir>$(TargetDir)msixpublish\</AppPublishDir>
      </_FancyToolMsixMetadata>
    </ItemGroup>
  </Target>
</Project>
